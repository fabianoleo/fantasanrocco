<%# ── Hero ──────────────────────────────────────────────────────── %>
<div class="lb-hero">
  <p class="lp-kicker">Live</p>
  <h1 class="lb-hero-title">Classifica</h1>
  <p class="lb-hero-sub">La gara dei premi e i record del mini-gioco, in un colpo d'occhio.</p>
</div>

<%# ── Tab ───────────────────────────────────────────────────────── %>
<div class="lb-tabs" role="tablist">
  <button class="lb-tab active" type="button" role="tab" data-target="lbPanelGeneral"><%- icon('trophy') %> Generale</button>
  <button class="lb-tab" type="button" role="tab" data-target="lbPanelGame"><%- icon('bolt') %> Gioco</button>
</div>

<%# ════════════════════ PANNELLO GENERALE ════════════════════════ %>
<div class="lb-panel lb-panel-active" id="lbPanelGeneral">
<% if (rows.length === 0) { %>

  <div class="lb-empty">
    <span class="lb-empty-icon"><%- icon('trophy') %></span>
    <p>Ancora nessun punto assegnato.</p>
    <p class="muted small">Completa le prime missioni e sarai il primo in classifica.</p>
    <% if (currentUser) { %>
      <a href="/missioni" class="btn" style="margin-top:1.5rem">Vai alle missioni →</a>
    <% } %>
  </div>

<% } else { %>

  <%# ── Podio top 3 ─────────────────────────────────────────────── %>
  <% const top3 = rows.slice(0, 3); %>
  <% const rest = rows.slice(3); %>

  <div class="lb-podium-wrap">
    <% const podiumOrder = [top3[1], top3[0], top3[2]].filter(Boolean); %>
    <% podiumOrder.forEach((u, pi) => { %>
      <% const realIdx = top3.indexOf(u); %>
      <% const isMe    = currentUserId && u.id === currentUserId; %>
      <div class="lb-podium-card lb-podium-<%= ['gold','silver','bronze'][realIdx] %> <%= realIdx === 0 ? 'lb-podium-first' : '' %> <%= isMe ? 'lb-me' : '' %>">
        <span class="lb-podium-avatar-wrap">
          <%- include('partials/avatar', { user: u, cls: 'lb-podium-avatar' }) %>
          <span class="lb-podium-medal"><%- icon('medal') %></span>
        </span>
        <span class="lb-podium-name"><%= u.nickname %><% if (isMe) { %> <span class="lb-you">tu</span><% } %></span>
        <span class="lb-podium-pts"><%= u.points %></span>
        <span class="lb-podium-pts-label">punti</span>
        <span class="lb-podium-done"><%= u.done %> missioni</span>
        <% const premioPodio = premioPerPosizione[realIdx + 1]; %>
        <% if (premioPodio) { %>
          <a class="lb-prize lb-prize-podio" href="/premio" title="<%= premioPodio.nome %><%= premioPodio.valore ? ' — ' + premioPodio.valore : '' %>"><%- icon(premioPodio.icona) %><span class="lb-prize-txt"><%= premioPodio.nome %></span></a>
        <% } %>
        <div class="lb-podium-bar lb-podium-bar-<%= ['gold','silver','bronze'][realIdx] %>"></div>
      </div>
    <% }) %>
  </div>

  <%# ── Lista dal 4° in poi ─────────────────────────────────────── %>
  <% if (rest.length > 0) { %>
  <div class="lb-list-wrap card">
    <h2 class="lb-list-title">Tutti i partecipanti</h2>
    <ol class="lb-list" start="4">
      <% rest.forEach((u, i) => { %>
        <% const isMe = currentUserId && u.id === currentUserId; %>
        <%# Il premio è legato alla POSIZIONE, non alla persona: la riga mostra
            cosa si porta a casa chi chiude la festa in quel punto. %>
        <% const premio = premioPerPosizione[i + 4]; %>
        <li class="lb-list-row <%= isMe ? 'lb-me' : '' %>">
          <span class="lb-list-rank"><%= i + 4 %></span>
          <span class="lb-list-name">
            <%= u.nickname %><% if (isMe) { %> <span class="lb-you">tu</span><% } %>
            <% if (premio) { %>
              <%# Qui va solo il nome del premio, su una riga sola: chi lo offre
                  starebbe stretto su un telefono e sta gia' scritto in /premio.
                  Resta nel title per chi passa il mouse. %>
              <a class="lb-prize" href="/premio" title="<%= premio.nome %><%= premio.offerto ? ' — offerto da ' + premio.offerto : '' %>"><%- icon(premio.icona) %><span class="lb-prize-txt"><%= premio.nome %></span></a>
            <% } %>
          </span>
          <span class="lb-list-done"><%= u.done %> miss.</span>
          <span class="lb-list-pts"><%= u.points %><small>pt</small></span>
        </li>
      <% }) %>
    </ol>
  </div>
  <% } %>

<% } %>
</div>

<%# ════════════════════ PANNELLO GIOCO (2 giochi) ═════════════════ %>
<div class="lb-panel" id="lbPanelGame">

  <p class="muted small lb-game-intro">
    Qui contano i <strong>record</strong> di ogni gioco, separati.
    I punti della <a href="#" class="lb-golink" data-target="lbPanelGeneral">classifica generale</a>
    non arrivano dal record, ma dai <strong>traguardi</strong>: le soglie di punteggio in
    «Corri San Rocco» e i <strong>gradi</strong> del Jetpack (a stelle accumulate).
  </p>

  <%# ── Sotto-tab: un gioco per volta ───────────────────────────── %>
  <div class="lb-subtabs" role="tablist">
    <button class="lb-subtab active" type="button" role="tab" data-target="lbGameRunner"><%- icon('bolt') %> Corri San Rocco</button>
    <button class="lb-subtab" type="button" role="tab" data-target="lbGameJetpack"><%- icon('fireworks') %> San Rocco Jetpack</button>
  </div>

  <%# ── 1. CORRI SAN ROCCO ──────────────────────────────────────── %>
  <div class="lb-subpanel lb-subpanel-active" id="lbGameRunner">
  <% if (gameRows.length === 0) { %>
    <div class="lb-empty">
      <span class="lb-empty-icon"><%- icon('bolt') %></span>
      <p>Nessun punteggio registrato.</p>
      <p class="muted small">Sii il primo a correre con San Rocco e a entrare in classifica.</p>
      <a href="/giochi?g=runner" class="btn" style="margin-top:1.5rem"><%- icon('bolt') %> Vai al gioco</a>
    </div>
  <% } else { %>
    <div class="lb-list-wrap card">
      <h2 class="lb-list-title">I migliori punteggi · «Corri San Rocco»</h2>
      <ol class="lb-list lb-list-game">
        <% gameRows.forEach((u, i) => { %>
          <% const isMe = currentUserId && u.id === currentUserId; %>
          <li class="lb-list-row <%= isMe ? 'lb-me' : '' %>">
            <span class="lb-list-rank">
              <% if (i < 3) { %><span class="lb-medal-inline <%= ['is-gold','is-silver','is-bronze'][i] %>"><%- icon('medal') %></span><% } else { %><%= i + 1 %><% } %>
            </span>
            <span class="lb-list-name">
              <%= u.nickname %><% if (isMe) { %> <span class="lb-you">tu</span><% } %>
              <%# Il premio del gioco va a chi comanda QUESTA classifica, non a
                  chi ha più punti in quella generale: si mostra solo in cima. %>
              <% if (i === 0 && premioPerGioco.runner) { %>
                <a class="lb-prize" href="/premio" title="<%= premioPerGioco.runner.nome %> — a chi vince Corri San Rocco"><%- icon(premioPerGioco.runner.icona) %><span class="lb-prize-txt"><%= premioPerGioco.runner.nome %></span></a>
              <% } %>
            </span>
            <span class="lb-list-pts"><%= u.best %><small>punti</small></span>
          </li>
        <% }) %>
      </ol>
    </div>
    <p class="muted small" style="text-align:center;margin-top:1.2rem">
      Il record si aggiorna ad ogni partita su <a href="/giochi?g=runner" style="color:var(--gold)">Corri San Rocco</a>.
    </p>
  <% } %>
  </div>

  <%# ── 2. SAN ROCCO JETPACK ────────────────────────────────────── %>
  <div class="lb-subpanel" id="lbGameJetpack">
  <% if (jetpackRows.length === 0) { %>
    <div class="lb-empty">
      <span class="lb-empty-icon"><%- icon('fireworks') %></span>
      <p>Nessun volo registrato.</p>
      <p class="muted small">Sii il primo a volare con San Rocco e a entrare in classifica.</p>
      <a href="/giochi?g=jetpack" class="btn" style="margin-top:1.5rem"><%- icon('fireworks') %> Vai al Jetpack</a>
    </div>
  <% } else { %>
    <div class="lb-list-wrap card">
      <h2 class="lb-list-title">Le distanze più lunghe · «San Rocco Jetpack»</h2>
      <ol class="lb-list lb-list-game">
        <% jetpackRows.forEach((u, i) => { %>
          <% const isMe = currentUserId && u.id === currentUserId; %>
          <li class="lb-list-row <%= isMe ? 'lb-me' : '' %>">
            <span class="lb-list-rank">
              <% if (i < 3) { %><span class="lb-medal-inline <%= ['is-gold','is-silver','is-bronze'][i] %>"><%- icon('medal') %></span><% } else { %><%= i + 1 %><% } %>
            </span>
            <span class="lb-list-name">
              <%= u.nickname %><% if (isMe) { %> <span class="lb-you">tu</span><% } %>
              <% if (u.stars) { %><span class="lb-stars">★ <%= u.stars %></span><% } %>
              <% if (i === 0 && premioPerGioco.jetpack) { %>
                <a class="lb-prize" href="/premio" title="<%= premioPerGioco.jetpack.nome %> — a chi vince San Rocco Jetpack"><%- icon(premioPerGioco.jetpack.icona) %><span class="lb-prize-txt"><%= premioPerGioco.jetpack.nome %></span></a>
              <% } %>
            </span>
            <span class="lb-list-pts"><%= u.best %><small>metri</small></span>
          </li>
        <% }) %>
      </ol>
    </div>
    <p class="muted small" style="text-align:center;margin-top:1.2rem">
      Il record si aggiorna ad ogni partita su <a href="/giochi?g=jetpack" style="color:var(--gold)">San Rocco Jetpack</a>.
      Le ★ sono le missioni di carriera completate.
    </p>
  <% } %>
  </div>

</div>
