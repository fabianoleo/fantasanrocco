<%# ── Hero ──────────────────────────────────────────────────────── %>
<div class="lb-hero">
  <p class="lp-kicker">Live</p>
  <h1 class="lb-hero-title">Classifica</h1>
  <p class="lb-hero-sub">La gara dei premi e i record del mini-gioco, in un colpo d'occhio.</p>
</div>

<%# Le tre classifiche passano tutte dallo stesso pezzo (partials/leaderboard-card):
    scheda col titolo, podio dei primi tre, lista paginata sotto. Qui si prepara
    solo il contenuto — nomi, valori, premi — normalizzato nella forma che il
    partial si aspetta, perché "quanti punti" e "quanti metri" sono la stessa
    colonna con un'unità diversa. %>
<%
  const periodo = 'Festa di San Rocco 2026 · Siano';

  const righeGenerale = rows.map(function (u, i) {
    const p = premioPerPosizione[i + 1];
    return {
      id: u.id,
      nome: u.nickname,
      byline: u.done + (u.done === 1 ? ' missione' : ' missioni'),
      valore: u.points,
      unita: 'pt',
      utente: u,
      premio: p ? { nome: p.nome, icona: p.icona,
                    title: p.nome + (p.offerto ? ' — offerto da ' + p.offerto : (p.valore ? ' — ' + p.valore : '')) } : null,
    };
  });

  // Nei giochi il premio è UNO e va a chi comanda: si attacca solo al primo,
  // non alla posizione come nella generale.
  function righeGioco(elenco, unita, premio, byline) {
    return elenco.map(function (u, i) {
      return {
        id: u.id,
        nome: u.nickname,
        byline: byline ? byline(u) : null,
        valore: u.best,
        unita: unita,
        utente: u,
        premio: (i === 0 && premio) ? { nome: premio.nome, icona: premio.icona, title: premio.nome + ' — a chi vince' } : null,
      };
    });
  }

  const righeRunner = righeGioco(gameRows, 'punti', premioPerGioco.runner, null);
  const righeJetpack = righeGioco(jetpackRows, 'metri', premioPerGioco.jetpack,
    function (u) { return u.stars ? '★ ' + u.stars : null; });
%>

<%# ── Tab ───────────────────────────────────────────────────────── %>
<div class="lb-tabs" role="tablist">
  <button class="lb-tab active" type="button" role="tab" data-target="lbPanelGeneral"><%- icon('trophy') %> Generale</button>
  <button class="lb-tab" type="button" role="tab" data-target="lbPanelGame"><%- icon('bolt') %> Gioco</button>
</div>

<%# ════════════════════ PANNELLO GENERALE ════════════════════════ %>
<div class="lb-panel lb-panel-active" id="lbPanelGeneral">
  <%- include('partials/leaderboard-card', { lb: {
        titolo: 'Classifica generale',
        periodo: periodo,
        righe: righeGenerale,
        mioId: currentUserId,
        avatar: true,
        iconaVuoto: 'trophy',
        testoVuoto: 'Ancora nessun punto assegnato.',
        sottoVuoto: 'Completa le prime missioni e sarai il primo in classifica.',
        ctaVuoto: currentUser ? { href: '/missioni', label: 'Vai alle missioni →' } : null,
      } }) %>
</div>

<%# ════════════════════ PANNELLO GIOCO (2 giochi) ═════════════════ %>
<div class="lb-panel" id="lbPanelGame">

  <p class="muted small lb-game-intro">
    Qui contano i <strong>record</strong> di ogni gioco, separati.
    I punti della <a href="#" class="lb-golink" data-target="lbPanelGeneral">classifica generale</a>
    non arrivano dal record, ma dai <strong>traguardi</strong>: le soglie di punteggio in
    «Corri San Rocco» e i <strong>gradi</strong> del Jetpack (a stelle accumulate).
  </p>

  <%# ── Sotto-tab: un gioco per volta ───────────────────────────── %>
  <div class="lb-subtabs" role="tablist">
    <button class="lb-subtab active" type="button" role="tab" data-target="lbGameRunner"><%- icon('bolt') %> Corri San Rocco</button>
    <button class="lb-subtab" type="button" role="tab" data-target="lbGameJetpack"><%- icon('fireworks') %> San Rocco Jetpack</button>
  </div>

  <div class="lb-subpanel lb-subpanel-active" id="lbGameRunner">
    <%- include('partials/leaderboard-card', { lb: {
          titolo: 'Corri San Rocco',
          periodo: 'I migliori punteggi',
          righe: righeRunner,
          mioId: currentUserId,
          avatar: true,
          iconaVuoto: 'bolt',
          testoVuoto: 'Nessun punteggio registrato.',
          sottoVuoto: 'Sii il primo a correre con San Rocco e a entrare in classifica.',
          ctaVuoto: { href: '/giochi?g=runner', label: 'Vai al gioco' },
          nota: 'Il record si aggiorna ad ogni partita su <a href="/giochi?g=runner">Corri San Rocco</a>.',
        } }) %>
  </div>

  <div class="lb-subpanel" id="lbGameJetpack">
    <%- include('partials/leaderboard-card', { lb: {
          titolo: 'San Rocco Jetpack',
          periodo: 'Le distanze più lunghe',
          righe: righeJetpack,
          mioId: currentUserId,
          avatar: true,
          iconaVuoto: 'fireworks',
          testoVuoto: 'Nessun volo registrato.',
          sottoVuoto: 'Sii il primo a volare con San Rocco e a entrare in classifica.',
          ctaVuoto: { href: '/giochi?g=jetpack', label: 'Vai al Jetpack' },
          nota: 'Il record si aggiorna ad ogni partita su <a href="/giochi?g=jetpack">San Rocco Jetpack</a>. Le ★ sono le missioni di carriera completate.',
        } }) %>
  </div>

</div>

<script src="/classifica.js?v=1" defer></script>
