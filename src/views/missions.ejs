<h1>Missioni</h1>
<p class="muted">Tocca una missione per inviare la tua prova. <span style="color:var(--green)"><%- icon('dot') %></span> = puoi farla ora.<br>
  <span class="small">Ogni missione si può fare <strong>una volta al giorno</strong> (il giorno va dalle 18:00 alle 17:59 del giorno dopo). Quelle <em>ripetibili</em> si possono rifare più volte.</span></p>

<%# ── Pronostici generici (creati dall'admin) ─────────────────────── %>
<% if (typeof predictions !== 'undefined' && predictions && predictions.length) { %>
  <% predictions.forEach((pr) => { %>
    <section class="prono-card">
      <div class="prono-glow" aria-hidden="true"></div>
      <div class="prono-head">
        <span class="prono-ico"><%- icon('target') %></span>
        <div>
          <p class="prono-kicker">Pronostico</p>
          <h2 class="prono-title"><%= pr.title %></h2>
        </div>
        <span class="prono-prize"><%= pr.points %> pt</span>
      </div>

      <%
        const myNames = (pr.myChoices || []).map((i) => pr.options[i]).filter(Boolean);
        const hasVoted = myNames.length > 0;
      %>
      <% if (pr.resolved) { %>
        <% const won = (pr.myChoices || []).includes(pr.winner);
           const halved = won && pr.myChoices.length > 1; %>
        <div class="prono-result <%= won ? 'is-win' : (hasVoted ? 'is-lose' : '') %>">
          <p class="prono-winner"><%- icon('trophy') %> Esito: <strong><%= pr.options[pr.winner] %></strong></p>
          <% if (won) { %>
            <p class="prono-outcome prono-outcome-win"><%- icon('sparkle') %> Hai indovinato! <strong>+<%= halved ? Math.floor(pr.points / 2) : pr.points %> punti</strong> accreditati<% if (halved) { %> (metà, avevi scelto più risposte)<% } %>.</p>
          <% } else if (hasVoted) { %>
            <p class="prono-outcome">Avevi scelto <strong><%= myNames.join(', ') %></strong>. Sarà per la prossima!</p>
          <% } else { %>
            <p class="prono-outcome">Non avevi fatto il tuo pronostico.</p>
          <% } %>
        </div>
      <% } else if (pr.open) { %>
        <p class="prono-desc">
          <% if (pr.description) { %><%= pr.description %><br><% } else { %>Scegli <% if (pr.multi) { %>una o più opzioni<% } else { %><strong>una sola</strong> opzione<% } %>: se indovini, ti porti a casa <strong><%= pr.points %> punti</strong>.<br><% } %>
          <% if (pr.multi) { %><span class="prono-current"><%- icon('warning') %> Puoi scegliere più opzioni, ma se ne indichi più d'una i punti si <strong>dimezzano</strong>.</span><br><% } %>
          <% if (hasVoted) { %><span class="prono-current"><%- icon('check-circle') %> La tua scelta: <strong><%= myNames.join(', ') %></strong> — puoi ancora cambiarla.</span><% } %>
        </p>
        <form action="/pronostici/<%= pr.id %>/vota" method="post" class="prono-form" <% if (!pr.multi) { %>data-saved="<%= pr.myChoices.length ? pr.myChoices[0] : '' %>"<% } %>>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="prono-options">
            <% pr.options.forEach((name, i) => { const sel = (pr.myChoices || []).includes(i); %>
              <label class="prono-opt <%= sel ? 'is-current' : '' %>">
                <input type="<%= pr.multi ? 'checkbox' : 'radio' %>" name="choice" value="<%= i %>" <%= sel ? 'checked' : '' %> <%= pr.multi ? '' : 'required' %>>
                <span class="prono-opt-num"><%= String(i + 1).padStart(2, '0') %></span>
                <span class="prono-opt-name"><%= name %></span>
                <% if (!pr.multi) { %><span class="prono-opt-flag">in uscita</span><% } %>
                <span class="prono-opt-tick"><%- icon('check') %></span>
              </label>
            <% }) %>
          </div>
          <button class="btn prono-btn" type="submit" data-haptic><%- icon('target') %> <%= hasVoted ? 'Aggiorna il pronostico' : 'Conferma il pronostico' %></button>
        </form>
      <% } else { %>
        <p class="prono-desc"><%- icon('hourglass') %> Pronostico chiuso. In attesa dell'esito!
          <% if (hasVoted) { %><br><span class="prono-current">La tua scelta: <strong><%= myNames.join(', ') %></strong></span><% } %>
        </p>
      <% } %>
    </section>
  <% }) %>
<% } %>

<%# ── Progresso sezioni (bonus al completamento) ──────────────────── %>
<% const secs = (typeof sections !== 'undefined' && sections) ? sections : []; %>
<% if (secs.length) { %>
  <section class="card ms-secpanel">
    <%# «fino a»: il bonus non è più uguale per tutte le sezioni, e ognuna
        dice il suo qui sotto. Promettere una cifra sola sarebbe una bugia
        per tre sezioni su quattro. %>
    <h2 class="staff-title"><%- icon('trophy') %> Sezioni · completa tutte le missioni di una sezione e prendi <strong>fino a +<%= sectionBonusMax %> punti</strong></h2>
    <div class="ms-secgrid">
      <% secs.forEach((s) => { %>
        <a class="ms-secprog ms-sec-<%= s.color %> <%= s.completed ? 'is-done' : '' %>" href="#sez-<%= s.key %>">
          <span class="ms-secprog-top">
            <span class="ms-secprog-name"><%= s.label %></span>
            <span class="ms-secprog-val"><%= s.done %>/<%= s.total %></span>
          </span>
          <span class="ms-secprog-bar"><span style="width:<%= Math.round(s.done / s.total * 100) %>%"></span></span>
          <span class="ms-secprog-foot">
            <% if (s.completed) { %><%- icon('check-circle') %> Completata · +<%= s.bonus %> pt<% } else { %>Mancano <%= s.total - s.done %> · +<%= s.bonus %> pt<% } %>
          </span>
        </a>
      <% }) %>
    </div>
  </section>
<% } %>

<%
  // Raggruppa le missioni per sezione; quelle senza sezione (sfide giornaliere,
  // flash) finiscono in un gruppo a parte.
  const groups = [];
  secs.forEach((s) => {
    const ms = missions.filter((m) => m.section === s.key);
    if (ms.length) groups.push({ sec: s, list: ms });
  });
  const others = missions.filter((m) => !m.section);
  if (others.length) groups.push({ sec: null, list: others });

  /* Le sfide speciali si dividono per GIORNO, in ordine crescente: sono la
     sorpresa della festa, e quello che conta sapere non è quali sono ma
     quante ne escono e quando. La chiave è la data nuda (YYYY-MM-DD), che
     si ordina da sola come stringa senza passare per Date.
     Quelle senza finestra valgono sempre, quindi non stanno in nessun
     giorno: vanno in fondo, in un gruppo loro. */
  function perGiorno(elenco) {
    const perData = new Map();
    const senzaData = [];
    elenco.forEach((m) => {
      if (!m.giornoKey) { senzaData.push(m); return; }
      if (!perData.has(m.giornoKey)) perData.set(m.giornoKey, { key: m.giornoKey, label: m.giornoLabel, list: [] });
      perData.get(m.giornoKey).list.push(m);
    });
    const fasce = Array.from(perData.values()).sort((a, b) => a.key < b.key ? -1 : 1);
    if (senzaData.length) fasce.push({ key: null, label: null, list: senzaData });
    return fasce;
  }
  const staffPuoSbirciare = (typeof staff !== 'undefined' && staff);
%>
<%# ── Ricerca fra le missioni ───────────────────────────────────────────
    Tutto nel browser: le card sono gia' tutte in pagina, quindi cercare non
    ha motivo di passare dal server. Le missioni ancora coperte non entrano
    nella ricerca — il loro testo non e' nell'HTML — e restano al loro posto,
    perche' farle sparire mentre si cerca direbbe quante ne mancano. %>
<div class="ms-cerca-barra" data-ms-barra>
  <label class="ms-cerca">
    <%- icon('search') %>
    <input type="search" placeholder="Cerca una missione…" data-ms-cerca
           aria-label="Cerca fra le missioni" autocomplete="off">
  </label>
  <p class="ms-cerca-esito" data-ms-esito hidden></p>
</div>

<% groups.forEach((g) => { %>
  <% if (g.sec) { %>
    <div class="ms-sechead ms-sec-<%= g.sec.color %> <%= g.sec.completed ? 'is-done' : '' %>" id="sez-<%= g.sec.key %>">
      <span><%= g.sec.label %> (<%= g.sec.total %>)</span>
      <span class="ms-sechead-badge"><%= g.sec.done %>/<%= g.sec.total %> · +<%= g.sec.bonus %> pt</span>
    </div>

    <div class="mission-grid">
      <%# Il pronostico del Palio conta come tappa di "Paese & Tradizione", ma si
          vota su /palio: qui c'è solo il collegamento. %>
      <% if (g.sec.key === 'paese' && typeof palioLink !== 'undefined' && palioLink) { %>
        <a class="mission-card mission-card-link" href="/palio#pronostico">
          <div class="mission-head">
            <h3><span class="m-bonus">BONUS</span> <span class="m-name">Pronostico del Palio</span></h3>
            <span class="points-badge"><%= palioLink.points %> pt</span>
          </div>
          <p class="mission-desc">Indovina quale fuochista vince il Palio. Si vota nella pagina <strong>Palio dei Fuochi</strong>: basta dare una risposta perché conti per questa sezione.</p>
          <div class="mission-meta">
            <% if (palioLink.voted) { %>
              <span class="tag tag-ok"><%- icon('check-circle') %> Pronostico dato</span>
            <% } else if (palioLink.open) { %>
              <span class="tag tag-live"><%- icon('dot') %> Da fare</span>
            <% } else { %>
              <span class="tag tag-off"><%- icon('hourglass') %> Pronostici chiusi</span>
            <% } %>
            <span class="tag"><%- icon('fireworks') %> Vai al Palio →</span>
          </div>
        </a>
      <% } %>
      <% g.list.forEach((m) => { %>
        <%- include('partials/mission-card', { m: m, sbircia: false }) %>
      <% }) %>
    </div>

  <% } else { %>
    <%# ── SFIDE SPECIALI ────────────────────────────────────────────────
        Divise per giorno, in ordine crescente. Sono la sorpresa della festa:
        finché non è il loro giorno restano coperte, e quello che si deve
        capire a colpo d'occhio è quante ne escono e quando. %>
    <% const fasce = perGiorno(g.list); %>
    <div class="ms-sechead ms-sec-other">
      <span>Sfide speciali</span>
      <% if (staffPuoSbirciare) { %>
        <%# Solo per lo staff, e solo per gli occhi di chi preme: scopre le
            carte in questa pagina e basta, non pubblica niente. Ricaricando
            tornano coperte. %>
        <button type="button" class="ms-sbircia" data-ms-sbircia aria-pressed="false">
          <%- icon('key') %> <span class="ms-sbircia-txt">Sbircia</span>
        </button>
      <% } %>
    </div>

    <% fasce.forEach((f) => { %>
      <div class="ms-giorno">
        <span class="ms-giorno-lab">
          <%- icon(f.label ? 'clock' : 'sparkle') %>
          <%= f.label ? f.label : 'Sempre disponibili' %>
        </span>
        <span class="ms-giorno-n"><%= f.list.length %></span>
      </div>
      <div class="mission-grid">
        <% f.list.forEach((m) => { %>
          <%- include('partials/mission-card', { m: m, sbircia: staffPuoSbirciare }) %>
        <% }) %>
      </div>
    <% }) %>
  <% } %>
<% }) %>
<% if (missions.length === 0) { %>
  <p class="muted">Nessuna missione disponibile al momento. Torna più tardi!</p>
<% } %>

<script src="/missioni.js?v=3" defer></script>
