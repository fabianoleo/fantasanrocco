<% GIORNI.forEach(function (g) { %>
  <div class="pg-day lp-full">
    <div class="pg-day-inner">
      <div class="pg-day-header">
        <span class="pg-day-num"><%= g.num %></span>
        <div class="pg-day-info">
          <span class="pg-day-name"><%= g.nome %></span>
          <span class="pg-day-month">Agosto 2026</span>
        </div>
        <div class="pg-day-line"></div>
      </div>
      <% if (g.occhiello) { %><p class="pg-day-kicker"><%= g.occhiello %></p><% } %>

      <%# Civile prima, religioso dopo. Il titoletto compare solo se il giorno
          ha davvero tutte e due le parti: il 12 e il 13 sono solo religiosi, e
          scrivere «Programma religioso» sopra l'unica cosa che c'e' sarebbe
          rumore. %>
      <% const dueParti = g.civile.length > 0 && g.religioso.length > 0; %>
      <%# L'elenco sta in una variabile e non scritto in linea nel forEach: una
          riga che comincia con «[» viene letta come indicizzazione di quella
          prima, e il template non compila piu'. %>
      <% const parti = [{ tipo: 'civile', elenco: g.civile }, { tipo: 'religioso', elenco: g.religioso }]; %>
      <% parti.forEach(function (parte) { %>
        <% const tipo = parte.tipo, elenco = parte.elenco; %>
        <% if (elenco.length) { %>
        <% if (dueParti) { %>
          <p class="pg-parte pg-parte-<%= tipo %>">
            <%- icon(tipo === 'civile' ? 'music' : 'candle') %>
            Programma <%= tipo %>
          </p>
        <% } %>
        <% elenco.forEach(function (e) { %>
          <article class="pg-card pg-<%= e.fascia %> <%= tipo === 'religioso' ? 'pg-religioso' : '' %> <%= e.grande ? 'pg-card-grande' : '' %>">
            <div class="pg-card-time">
              <span class="pg-time-icon"><%- icon(tipo === 'religioso' ? 'candle' : ICONA_FASCIA[e.fascia]) %></span>
              <span class="pg-time-val"><%= e.ora %></span>
              <span class="pg-time-label"><%= NOME_FASCIA[e.fascia] %><% if (e.fino) { %> &nbsp;–&nbsp; <%= e.fino %><% } %></span>
            </div>
            <div class="pg-card-body">
              <div class="pg-card-meta">
                <span class="pg-location"><%- icon('pin') %><%= e.luogo %></span>
              </div>
              <h2 <% if (e.luogoId) { %>data-map-place="<%= e.luogoId %>"<% } %>
                  class="pg-card-title <%= e.grande ? 'pg-title-grande' : '' %>"
                  <% if (e.fuoco) { %>style="-webkit-text-fill-color: var(--fire) !important; color: var(--fire) !important; text-shadow: 0 0 28px rgba(232,78,27,.5);"<% } %>><%- e.titolo %><% if (e.sottotitolo) { %><br><span class="pg-card-subtitle"><%= e.sottotitolo %></span><% } %></h2>
              <% if (e.desc) { %><p class="pg-card-desc"><%= e.desc %></p><% } %>
              <% if (e.immagine) { %>
                <div class="pg-card-media"><img src="<%= e.immagine %>" alt="<%= e.titolo.replace(/&amp;/g, 'e') %>" loading="lazy"></div>
              <% } %>
              <div class="pg-badges">
                <% if (tipo === 'religioso') { %>
                  <span class="pg-badge pg-badge-big"><%- icon('candle') %> Rito Religioso</span>
                <% } else if (e.badge && BADGE[e.badge]) { %>
                  <span class="pg-badge <%= BADGE[e.badge].cls %>"><%- icon(BADGE[e.badge].ico) %> <%= BADGE[e.badge].txt %></span>
                <% } %>
              </div>
            </div>
          </article>
        <% }) %>
        <% } %>
      <% }) %>
    </div>
  </div>
<% }) %>

<%# ── MAPPA DEI LUOGHI (Leaflet + OpenStreetMap) ──────────────────── %>
<% if (typeof places !== 'undefined' && places && places.length) { %>
<section class="sia-wrap lp-full" id="mappa">
  <div class="sia-hero-inner" style="text-align:center;margin-bottom:1.2rem">
    <p class="lp-kicker">Siano (SA)</p>
    <h2 class="sia-title" style="font-size:clamp(1.6rem,5vw,2.4rem)">I luoghi della festa</h2>
    <p class="sia-sub">Tocca un punto sulla mappa o nella lista per vedere gli eventi collegati.</p>
  </div>
  <div class="sia-grid">
    <div class="sia-map-col">
      <div id="siaMap" class="sia-map" aria-label="Mappa di Siano"></div>
      <button class="sia-reset" id="siaReset" type="button" hidden>
        <%- icon('repeat') %> Torna alla vista generale
      </button>
    </div>
    <aside class="sia-side">
      <div class="sia-card" id="siaCard" hidden>
        <span class="sia-card-handle" aria-hidden="true"></span>
        <button class="sia-card-close" id="siaCardClose" type="button" aria-label="Chiudi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="sia-card-media" id="siaCardMedia" hidden><span class="sia-card-media-grad"></span></div>
        <div class="sia-card-content">
          <div class="sia-card-head">
            <span class="sia-card-num" id="siaCardNum"></span>
            <div>
              <span class="sia-card-kicker"><%- icon('pin') %><span id="siaCardAddr"></span></span>
              <h3 class="sia-card-name" id="siaCardName"></h3>
            </div>
          </div>
          <p class="sia-card-desc" id="siaCardDesc" hidden></p>
          <div class="sia-card-events" id="siaCardEvents"></div>
        </div>
      </div>
      <div class="sia-list" id="siaList">
        <h2 class="sia-list-title">Esplora i luoghi</h2>
        <ul class="sia-list-items">
          <% places.forEach((p, i) => { %>
            <li>
              <button class="sia-li" data-place="<%= p.id %>" data-num="<%= i + 1 %>" <%= p.coordinates ? '' : 'data-nocoord="1"' %>>
                <span class="sia-li-num"><%= i + 1 %></span>
                <span class="sia-li-body">
                  <span class="sia-li-name"><%= p.name %></span>
                  <span class="sia-li-meta">
                    <%= p.events.length %> <%= p.events.length === 1 ? 'evento' : 'eventi' %><% if (!p.coordinates) { %> · <em>da posizionare</em><% } %>
                  </span>
                </span>
                <span class="sia-li-arrow"><%- icon('chevron-right') %></span>
              </button>
            </li>
          <% }) %>
        </ul>
        <p class="sia-list-note">Mappa © OpenStreetMap contributors · © CARTO</p>
      </div>
    </aside>
  </div>
</section>

<script type="application/json" id="siaPlaces"><%- JSON.stringify(places).replace(/</g, '\\u003c') %></script>
<script src="/vendor/leaflet.js" defer></script>
<script src="/map.js?v=6" defer></script>
<% } %>
