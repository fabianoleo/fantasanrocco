<%# ── HERO ─────────────────────────────────────────────────────── %>
<div class="pz-hero lp-full">
  <div class="pz-hero-inner">
    <p class="pz-hero-kicker">Festa di San Rocco 2026 &nbsp;·&nbsp; Siano</p>
    <h1 class="pz-title">I Premi<br>in Palio</h1>
    <p class="pz-subtitle">Quest'anno si vince fino al <strong><%= ultimaPosizione %>º posto</strong> in classifica,<br>più uno per ciascun mini-gioco e uno per il torneo su Instagram.</p>
    <%# Il valore del primo premio si legge dall'elenco: scritto a mano era
        rimasto a 250 € quando il cofanetto era già diventato un altro. %>
    <div class="pz-hero-pill">
      <span><%= totalePremi %></span> premi &nbsp;&middot;&nbsp; <span><%= premiPodio[0].valore %></span> il primo &nbsp;&middot;&nbsp; <span>agosto&nbsp;2026</span>
    </div>
  </div>
</div>

<%# ── PODIO: i primi tre, scheda grande ────────────────────────────────────
    Podio e lista sotto arrivano entrambi da PREMI in server.js, lo stesso
    elenco che alimenta la classifica: le due pagine non possono sfasarsi. %>
<%
  const stiliPodio = [
    { cls: 'pz-gold',   ghost: 'I',   label: 'Primo Posto',   bordo: 'pz-photo-border-gold' },
    { cls: 'pz-silver', ghost: 'II',  label: 'Secondo Posto', bordo: 'pz-photo-border-silver' },
    { cls: 'pz-bronze', ghost: 'III', label: 'Terzo Posto',   bordo: 'pz-photo-border-bronze' },
  ];
  premiPodio.forEach(function (p, i) {
    const st = stiliPodio[i];
    const foto = p.foto || [];
%>
  <div class="pz-section <%= st.cls %> lp-full">
    <div class="pz-rank-ghost"><%= st.ghost %></div>
    <div class="pz-section-inner">
      <div class="pz-section-info">
        <div class="pz-rank-label">
          <span class="pz-medal"><%- icon('medal') %></span>
          <span><%= st.label %></span>
        </div>
        <div class="pz-divider"></div>
        <h2 class="pz-prize-name"><%= p.nome %></h2>
        <p class="pz-prize-tagline"><%= p.tagline %></p>
        <p class="pz-prize-desc"><%= p.desc %></p>
        <%# Elenco facoltativo: serve al Percorso Spa, che è fatto di tappe.
            Sono etichette, non una lista puntata: in colonna occuperebbero
            mezza schermata e spingerebbero le foto fuori dallo schermo. %>
        <% if (p.incluso && p.incluso.length) { %>
          <ul class="pz-incluso">
            <% p.incluso.forEach(function (voce) { %>
              <li><%= voce %></li>
            <% }) %>
          </ul>
        <% } %>
        <ul class="pz-details">
          <li><%- icon(p.icona) %> <%= p.nome %></li>
          <% if (p.valore) { %><li><%- icon('gift') %> Valore <%= p.valore %></li><% } %>
          <% if (p.offerto) { %><li><%- icon('pin') %> Offerto da <%= p.offerto %></li><% } %>
          <li><%- icon('trophy') %> Va a chi chiude al <%= st.label.toLowerCase() %></li>
        </ul>
      </div>
      <div class="pz-photos-area">
        <%# Da tre foto in su il riquadro diventa un mazzo di carte: il primo
            premio ne ha otto, affiancate sarebbero otto francobolli. Si
            sfoglia trascinando su e giù, con le frecce o con i tasti.
            Senza JavaScript resta la prima carta, che è una foto normale. %>
        <% if (foto.length >= 3) { const didas = p.fotoDidascalie || []; %>
          <div class="pz-stack" data-pz-stack>
            <ul class="pz-stack-cards <%= st.bordo %>">
              <% foto.forEach(function (f, i) { %>
                <li class="pz-stack-card" style="--i: <%= i %>">
                  <img src="/images/premi/<%= f %>"
                       alt="<%= didas[i] || p.nome %>"
                       <%= i === 0 ? '' : 'loading="lazy"' %>
                       draggable="false">
                  <% if (didas[i]) { %><span class="pz-stack-cap"><%= didas[i] %></span><% } %>
                </li>
              <% }) %>
            </ul>
            <button type="button" class="pz-stack-nav pz-stack-prev" aria-label="Foto precedente"><%- icon('chevron-left') %></button>
            <button type="button" class="pz-stack-nav pz-stack-next" aria-label="Foto successiva"><%- icon('chevron-right') %></button>
            <div class="pz-stack-dots" aria-hidden="true">
              <% foto.forEach(function (f, i) { %><span class="pz-stack-dot"></span><% }) %>
            </div>
          </div>
        <% } else if (foto.length >= 2) { %>
          <div class="pz-photos-duo">
            <% foto.slice(0, 2).forEach(function (f) { %>
              <div class="pz-photo <%= st.bordo %>">
                <img src="/images/premi/<%= f %>" alt="<%= p.nome %>" loading="lazy">
              </div>
            <% }) %>
          </div>
        <% } else if (foto.length === 1) { %>
          <div class="pz-photo pz-photo-single <%= st.bordo %>">
            <img src="/images/premi/<%= foto[0] %>" alt="<%= p.nome %>" loading="lazy">
          </div>
        <%# Senza foto del premio, ma con il marchio dell'attività: il logo
            prende il riquadro al posto del segnaposto «Foto in arrivo».
            Sta da solo, senza didascalia: la scheda dice già nel testo e
            nell'elenco che rapporto c'è fra l'attività e il premio. %>
        <% } else if (p.logoSrc) { %>
          <div class="pz-photo-brand <%= st.bordo %>">
            <img src="<%= p.logoSrc %>" alt="<%= p.logoNome %>" loading="lazy">
          </div>
        <% } else { %>
          <div class="pz-photo-placeholder">
            <span class="pz-ph-icon"><%- icon(p.icona) %></span>
            <span>Foto in arrivo</span>
          </div>
        <% } %>
      </div>
    </div>
  </div>
<% }) %>

<%# ══ DAL QUARTO IN GIÙ ═══════════════════════════════════════════════════ %>
<div class="pz-sponsor lp-full">
  <div class="pz-sponsor-inner">
    <p class="pz-how-kicker">Offerti dalle attività di Siano</p>
    <%# L'ultima posizione cambia quando si aggiunge un premio, e con essa
        l'articolo: si legge "al 12º" ma "all'8º" e "all'11º", perché ottavo
        e undicesimo cominciano per vocale. %>
    <% const ultimaPos = premiLista[premiLista.length - 1].pos; %>
    <h2 class="pz-how-title">Dal 4º <%= ultimaPos === 8 || ultimaPos === 11 ? "all'" : 'al ' %><%= ultimaPos %>º posto</h2>
    <p class="pz-sponsor-intro">
      Il podio non è l'unico posto dove si vince: si porta a casa qualcosa
      anche arrivando <%= ultimaPos %>º.
    </p>

    <ol class="pz-sponsor-grid pz-grid-lista">
      <% premiLista.forEach(function (p) { %>
        <li class="pz-sp-card">
          <span class="pz-sp-pos"><%= p.pos %>º</span>
          <%# Ordine: prima il marchio dell'attività, poi la foto del premio,
              poi l'icona. Il logo dice più delle altre due — è chi ci mette
              il premio — e sta nello stesso ingombro, così le card della
              griglia restano alte uguali qualunque delle tre si mostri. %>
          <% if (p.logoSrc) { %>
            <span class="pz-sp-logo"><img src="<%= p.logoSrc %>" alt="<%= p.logoNome %>" loading="lazy"></span>
          <% } else if (p.foto && p.foto.length) { %>
            <span class="pz-sp-foto"><img src="/images/premi/<%= p.foto[0] %>" alt="<%= p.nome %>" loading="lazy"></span>
          <% } else { %>
            <span class="pz-sp-icon"><%- icon(p.icona) %></span>
          <% } %>
          <h3 class="pz-sp-name"><%= p.nome %></h3>
          <% if (p.nota) { %><p class="pz-sp-note"><%= p.nota %></p><% } %>
          <% if (p.offerto) { %><p class="pz-sp-by">da <strong><%= p.offerto %></strong></p><% } %>
          <% if (p.valore) { %><span class="pz-sp-value"><%= p.valore %></span><% } %>
        </li>
      <% }) %>
    </ol>

    <p class="pz-sponsor-foot">
      Ogni premio è già assegnato alla sua posizione: quello che vedi al 4º posto va a chi chiude quarto in classifica.
      Lo trovi indicato anche accanto al tuo nome nella <a href="/classifica">classifica</a>.
    </p>
  </div>
</div>

<%# ══ PREMI DEI DUE MINI-GIOCHI ═══════════════════════════════════════════
    Questi non si vincono a punti ma a record: hanno `gioco` invece di `pos`,
    e vanno a chi guida la classifica del proprio gioco. È una gara separata
    da quella generale, e la pagina deve dirlo chiaramente. %>
<div class="pz-sponsor lp-full">
  <div class="pz-sponsor-inner">
    <p class="pz-how-kicker">Una gara a parte</p>
    <h2 class="pz-how-title">I due mini-giochi</h2>
    <p class="pz-sponsor-intro">
      Chi comanda la classifica di ciascun gioco si porta a casa il suo premio.
      Qui non contano i punti della classifica generale, ma il <strong>record</strong>:
      il punteggio più alto in «Corri San Rocco» e la distanza più lunga in «San Rocco Jetpack».
    </p>

    <ol class="pz-sponsor-grid pz-grid-giochi">
      <% premiGiochi.forEach(function (p) { %>
        <li class="pz-sp-card">
          <span class="pz-sp-pos pz-sp-pos-gioco"><%= nomiGiochi[p.gioco] %></span>
          <% if (p.logoSrc) { %>
            <span class="pz-sp-logo"><img src="<%= p.logoSrc %>" alt="<%= p.logoNome %>" loading="lazy"></span>
          <% } else { %>
            <span class="pz-sp-icon"><%- icon(p.icona) %></span>
          <% } %>
          <h3 class="pz-sp-name"><%= p.nome %></h3>
          <% if (p.nota) { %><p class="pz-sp-note"><%= p.nota %></p><% } %>
          <% if (p.offerto) { %><p class="pz-sp-by">da <strong><%= p.offerto %></strong></p><% } %>
          <% if (p.valore) { %><span class="pz-sp-value"><%= p.valore %></span><% } %>
        </li>
      <% }) %>
    </ol>

    <p class="pz-sponsor-foot">
      I record si vedono nella <a href="/classifica">classifica</a>, nella scheda «Gioco».
      Attenzione: i <strong>punti</strong> che i giochi danno alla classifica generale
      arrivano dai traguardi, non dal record — sono due cose diverse.
    </p>
  </div>
</div>

<%# ══ PREMIO DEL TORNEO SU INSTAGRAM ══════════════════════════════════════
    Terza categoria: non si vince nè in classifica nè giocando qui. Sta in una
    sezione sua perchè mescolarlo agli altri lo prometterebbe a chi guarda la
    classifica, e da lì non si raggiunge. %>
<% if (premiTornei && premiTornei.length) { %>
<div class="pz-sponsor lp-full">
  <div class="pz-sponsor-inner">
    <p class="pz-how-kicker">Fuori dal sito</p>
    <h2 class="pz-how-title">Torneo delle Missioni su Instagram</h2>
    <%# Il testo cambia a torneo finito: finché nessuno ha vinto si spiega
        cos'è, dopo si dice com'è andata. Il primo premio con un vincitore
        decide per tutta la sezione — il torneo è uno solo. %>
    <% const vinto = premiTornei.find(function (p) { return p.vincitore; }); %>
    <p class="pz-sponsor-intro">
      <% if (vinto) { %>
        Il Torneo delle Missioni su Instagram si è chiuso: l'ha vinto
        <strong><%= vinto.vincitore %></strong><% if (vinto.vincitoreNick) { %>,
        in arte <strong><%= vinto.vincitoreNick %></strong><% } %>.
        Era una gara a parte, con regole sue: non si vinceva né in classifica
        né ai mini-giochi.
      <% } else { %>
        Questo premio non si vince né in classifica né ai mini-giochi: è del
        Torneo delle Missioni che si gioca su Instagram, con regole sue.
      <% } %>
    </p>

    <ol class="pz-sponsor-grid pz-grid-torneo">
      <% premiTornei.forEach(function (p) { %>
        <li class="pz-sp-card">
          <span class="pz-sp-pos pz-sp-pos-gioco">Torneo Instagram</span>
          <% if (p.logoSrc) { %>
            <span class="pz-sp-logo"><img src="<%= p.logoSrc %>" alt="<%= p.logoNome %>" loading="lazy"></span>
          <% } else { %>
            <span class="pz-sp-icon"><%- icon(p.icona) %></span>
          <% } %>
          <h3 class="pz-sp-name"><%= p.nome %></h3>
          <% if (p.vincitore) { %>
            <p class="pz-sp-vinto">
              <%- icon('trophy') %>
              <span>Vinto da <strong><%= p.vincitore %></strong><% if (p.vincitoreNick) { %> <em><%= p.vincitoreNick %></em><% } %></span>
            </p>
          <% } else if (p.nota) { %><p class="pz-sp-note"><%= p.nota %></p><% } %>
          <% if (p.offerto) { %><p class="pz-sp-by">da <strong><%= p.offerto %></strong></p><% } %>
          <% if (p.valore) { %><span class="pz-sp-value"><%= p.valore %></span><% } %>
        </li>
      <% }) %>
    </ol>

    <p class="pz-sponsor-foot">
      <% if (vinto) { %>
        Il torneo si giocava da <a href="https://www.instagram.com/fanta_sanrocco/" target="_blank" rel="noopener noreferrer">@fanta_sanrocco</a>.
      <% } else { %>
        Si partecipa da <a href="https://www.instagram.com/fanta_sanrocco/" target="_blank" rel="noopener noreferrer">@fanta_sanrocco</a>.
      <% } %>
    </p>
  </div>
<% } %>
</div>

<%# ── COME SI VINCE ────────────────────────────────────────────── %>
<div class="pz-how lp-full">
  <div class="pz-how-inner">
    <p class="pz-how-kicker">Regolamento</p>
    <h2 class="pz-how-title">Come si vince</h2>
    <div class="pz-steps">
      <div class="pz-step">
        <span class="pz-step-num">01</span>
        <div>
          <p class="pz-step-title">Completa le missioni</p>
          <p class="pz-step-desc">Ogni missione vale un numero di punti. Più missioni completi, più punti accumuli nella settimana della festa.</p>
        </div>
      </div>
      <div class="pz-step">
        <span class="pz-step-num">02</span>
        <div>
          <p class="pz-step-title">Invia la prova</p>
          <p class="pz-step-desc">Fotografia, video o descrizione: carica la tua prova per ogni missione completata. Lo staff la verificherà e ti assegnerà i punti.</p>
        </div>
      </div>
      <div class="pz-step">
        <span class="pz-step-num">03</span>
        <div>
          <p class="pz-step-title">Sali in classifica</p>
          <p class="pz-step-desc">I punti approvati entrano subito in classifica. Tieni d'occhio il tabellone: la gara è aperta fino alla fine della festa.</p>
        </div>
      </div>
      <div class="pz-step">
        <span class="pz-step-num">04</span>
        <div>
          <p class="pz-step-title">Vinci il premio</p>
          <p class="pz-step-desc">I primi <%= totalePremi %> in classifica a fine festa si aggiudicano i premi. Chi ne ha di più, vince.</p>
        </div>
      </div>
    </div>
    <div class="pz-how-cta">
      <% if (!currentUser) { %>
        <a class="btn" href="/login">Accedi e gioca &rarr;</a>
      <% } else { %>
        <a class="btn" href="/missioni">Vai alle missioni &rarr;</a>
      <% } %>
    </div>
  </div>
</div>

<script src="/premio-stack.js?v=2" defer></script>
