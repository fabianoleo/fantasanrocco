<%# ── Slot «Tombola di San Rocco» · 5 colonne × 4 righe ────────────────────
    La griglia la riempie slot5.js col risultato che arriva dal server: qui
    c'è solo l'impalcatura. La matematica sta in src/giochi/slot.js e non
    passa mai dal browser.
    ───────────────────────────────────────────────────────────────────── %>
<%
  const S5 = (typeof slot5 !== 'undefined' && slot5) ? slot5 : null;
  // Ordine della tabella: dal più forte al più debole, come si legge.
  const ORDINE = ['sanrocco', 'fuoco', 'braciola', 'vino', 'percoca', 'asso', 're', 'donna', 'jack', 'dieci'];
%>

<% if (!currentUser) { %>
  <div class="gx-locked">
    <span class="gx-locked-ic"><%- icon('ticket') %></span>
    <h3>Accedi per giocare alla Slot</h3>
    <p>La Slot punta i <strong>tuoi punti</strong> della classifica: per farla girare devi avere un account.</p>
    <div class="gx-locked-btns">
      <a class="btn" href="/login">Accedi</a>
      <a class="btn btn-ghost" href="/registrati">Registrati</a>
    </div>
  </div>
<% } else { %>
  <div class="cz-balance cz-balance-solo">
    <%- icon('trophy') %>
    <b id="czBalance"><%= balance %></b><span>punti disponibili</span>
  </div>

  <div class="sl-wrap" id="slSlot" data-csrf="<%= csrfToken %>"
       data-bet="<%= bets[0] %>" data-bet-min="<%= betMin %>" data-bet-max="<%= betMax %>">

    <%# Il pannello del bonus: nascosto finché il cane non parte %>
    <div class="sl-bonus" id="slBonus" hidden>
      <span class="sl-bonus-tit">La Corsa del Cane</span>
      <span class="sl-bonus-mult" id="slBonusMult">×1</span>
    </div>

    <div class="sl-griglia" id="slGriglia" aria-label="Griglia della slot">
      <% for (let c = 0; c < (S5 ? S5.colonne : 5); c++) { %>
        <div class="sl-col" data-col="<%= c %>">
          <% for (let r = 0; r < (S5 ? S5.righe : 4); r++) { %>
            <div class="sl-cella" data-col="<%= c %>" data-riga="<%= r %>"><%- simboloSlot(['dieci','jack','donna','re','asso'][(c + r) % 5]) %></div>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="cz-controls">
      <div class="cz-bets">
        <span class="cz-bet-lbl">Puntata</span>
        <% bets.forEach((b, i) => { %>
          <button type="button" class="cz-bet <%= i === 0 ? 'sel' : '' %>" data-bet="<%= b %>"><%= b %></button>
        <% }) %>
      </div>
      <div class="cz-betcustom">
        <button type="button" class="cz-betstep" id="czBetMinus" aria-label="Diminuisci la puntata di 5">&minus;</button>
        <label class="cz-betfield">
          <span class="sr-only">Puntata in punti (da <%= betMin %> a <%= betMax %>)</span>
          <input type="number" id="czBetInput" class="cz-betinput" inputmode="numeric" autocomplete="off"
                 min="<%= betMin %>" max="<%= betMax %>" step="1" value="<%= bets[0] %>">
          <span class="cz-betunit">pt</span>
        </label>
        <button type="button" class="cz-betstep" id="czBetPlus" aria-label="Aumenta la puntata di 5">+</button>
        <button type="button" class="cz-betmax" id="czBetMax">Max</button>
      </div>
      <p class="cz-beterr" id="czBetErr" role="status" aria-live="polite"></p>
      <button type="button" class="cz-spin" id="czSpin">Gira</button>
    </div>

    <p class="cz-outcome" id="czOutcome" aria-live="polite"></p>
  </div>

  <%# I simboli pronti da clonare: il JS non sa disegnarli, li copia da qui %>
  <div class="sl-magazzino" hidden aria-hidden="true">
    <% ['dieci','jack','donna','re','asso','percoca','vino','braciola','fuoco','sanrocco','jolly','cane'].forEach((k) => { %>
      <template id="sl-<%= k %>"><%- simboloSlot(k) %></template>
    <% }) %>
  </div>
<% } %>

<%# ── Tabella dei pagamenti ─────────────────────────────────────────── %>
<% if (S5) { %>
<section class="cz-paytable">
  <h2>Tabella vincite</h2>
  <p class="cz-pt-note">
    <%= S5.linee %> linee, si leggono da sinistra partendo dalla prima colonna.
    I numeri sono in unità di linea: la puntata si divide sulle <%= S5.linee %> linee.
  </p>

  <div class="sl-pt">
    <% ORDINE.forEach((k) => { const pag = S5.pagamenti[k]; if (!pag) return; %>
      <div class="sl-pt-riga <%= S5.simboli[k] && S5.simboli[k].alto ? 'is-alto' : '' %>">
        <span class="sl-pt-sym"><%- simboloSlot(k) %></span>
        <span class="sl-pt-nome"><%= S5.simboli[k] ? S5.simboli[k].label : k %></span>
        <span class="sl-pt-val">
          <% [2,3,4,5].forEach((n) => { if (!pag[n]) return; %>
            <span class="sl-pt-q"><b><%= n %></b> <%= pag[n] %></span>
          <% }) %>
        </span>
      </div>
    <% }) %>
  </div>

  <div class="sl-pt-speciali">
    <div class="sl-pt-speciale">
      <span class="sl-pt-sym"><%- simboloSlot('jolly') %></span>
      <div>
        <p class="n">Jolly · la conchiglia</p>
        <p class="d">Sostituisce ogni simbolo tranne il cane, e da sola paga come San Rocco.</p>
      </div>
    </div>
    <div class="sl-pt-speciale">
      <span class="sl-pt-sym"><%- simboloSlot('cane') %></span>
      <div>
        <p class="n">Il Cane · il bonus</p>
        <p class="d">
          <strong><%= S5.bonusMinimo %> cani</strong> in vista e parte <strong>La Corsa del Cane</strong>:
          il cane si mette sulla colonna più a destra dov'è uscito e cammina verso sinistra,
          una colonna per volta, facendo da jolly dove si trova. Le altre colonne rigirano a ogni passo
          e il moltiplicatore sale: <%= S5.moltiplicatori.map((m) => '×' + m).join(' · ') %>.
        </p>
      </div>
    </div>
  </div>
</section>
<% } %>
