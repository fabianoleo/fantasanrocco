<%# ── Mini-gioco «San Rocco Jetpack» — usato da giochi.ejs ────────── %>
<div class="jp-wrap" id="jpRoot"
     data-logged="<%= currentUser ? 1 : 0 %>"
     data-csrf="<%= csrfToken %>"
     data-best="<%= jpBest %>">
  <div class="jp-stage">
    <div class="jp-hud">
      <span id="jpScore">0 m</span>
      <span class="jp-best" id="jpBest">record 0</span>
    </div>
    <canvas class="jp-canvas" id="jpCanvas" aria-label="San Rocco Jetpack"></canvas>

    <%# Muta la canzone %>
    <button class="jp-mute-toggle" id="jpMuteBtn" type="button" aria-label="Muta la canzone" aria-pressed="false" title="Muta la canzone">
      <svg class="jp-ic-on" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M18.5 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg class="jp-ic-off" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 9l6 6M22 9l-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>

    <%# Pausa (visibile solo in gioco) %>
    <button class="jp-pause-toggle" id="jpPauseBtn" type="button" aria-label="Pausa" title="Pausa">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="0.5"/><rect x="14" y="5" width="4" height="14" rx="0.5"/></svg>
    </button>

    <div class="jp-toast" id="jpToast"></div>

    <div class="jp-overlay" id="jpOverlay">
      <p class="jp-kicker" id="jpKicker">Insert coin</p>
      <h3 class="jp-over-title" id="jpOverTitle">San Rocco Jetpack</h3>
      <p class="jp-over-desc" id="jpOverDesc">Vola con la fiammata, schiva i raggi di fuoco, raccogli le monete</p>
      <p class="jp-hint" id="jpHint">Tieni premuto <kbd>SPAZIO</kbd>, tocca lo schermo o il tasto <kbd>SALI</kbd> per volare</p>
      <button type="button" class="jp-play" id="jpPlay">Gioca</button>
    </div>

    <%# Overlay di pausa %>
    <div class="jp-overlay jp-hidden" id="jpPause" aria-hidden="true">
      <p class="jp-kicker">II</p>
      <h3 class="jp-over-title">Pausa</h3>
      <p class="jp-hint">Premi <kbd>P</kbd> o <kbd>Esc</kbd> per riprendere</p>
      <div class="jp-pause-btns">
        <button type="button" class="jp-play" id="jpResume">Riprendi</button>
        <button type="button" class="jp-btn2" id="jpRestart">Ricomincia</button>
        <button type="button" class="jp-btn2" id="jpQuit">Esci</button>
      </div>
    </div>
  </div>

  <%# Controller: pulsante di spinta (oltre al tocco sullo schermo) %>
  <div class="jp-pad" id="jpPad">
    <button class="jp-thrust" id="jpThrust" type="button" aria-label="Sali / spinta">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20V6"/><path d="M6 12l6-6 6 6"/></svg>
      <span class="jp-thrust-label">SALI</span>
    </button>
  </div>
</div>

<%# ── MISSIONI DI CARRIERA (restano fra le partite) ────────────────── %>
<section class="jp-mis" id="jpMissions" aria-label="Missioni del Jetpack">
  <div class="jp-mis-head">
    <div>
      <p class="jp-mis-kicker">Missioni di carriera</p>
      <h3 class="jp-mis-title">Tre obiettivi alla volta</h3>
    </div>
    <div class="jp-rank" title="Ogni <%= jpPerRank %> missioni completate sali di grado">
      <span class="jp-rank-stars" id="jpStars"><%= jpStars %></span>
      <span class="jp-rank-name" id="jpRankName"><%= jpRank %></span>
    </div>
  </div>

  <% if (!currentUser) { %>
    <p class="jp-mis-note">
      Queste sono le missioni del Jetpack: restano fra una partita e l'altra e ogni
      <strong><%= jpPerRank %></strong> completate sali di grado, guadagnando <strong>punti in classifica</strong>.
      Per tenerne traccia <a href="/login">accedi</a> o <a href="/registrati">registrati</a>.
    </p>
  <% } %>

  <div class="jp-mis-grid" id="jpMisGrid">
    <% jpMissions.forEach((m) => { %>
      <div class="jp-mis-card" data-key="<%= m.key %>">
        <p class="jp-mis-text"><%= m.text %></p>
        <div class="jp-mis-bar"><span style="width: <%= Math.round(m.progress / m.goal * 100) %>%"></span></div>
        <p class="jp-mis-prog"><%= m.progress %> / <%= m.goal %></p>
      </div>
    <% }) %>
  </div>

  <% if (currentUser) { %>
    <p class="jp-mis-note">
      Completandone una guadagni una stella e la casella viene sostituita da un nuovo obiettivo.
      Ogni <strong><%= jpPerRank %></strong> stelle sali di grado e i punti entrano nella <a href="/classifica">classifica</a>.
    </p>
  <% } %>
</section>

<%# ── LEGENDA MEZZI: le parole da comporre ─────────────────────────── %>
<section class="jp-legend" aria-label="Mezzi del Jetpack">
  <div class="jp-legend-head">
    <p class="jp-legend-kicker">Raccogli le lettere</p>
    <h3 class="jp-legend-title">Componi la parola e ti trasformi</h3>
    <p class="jp-legend-note">
      Durante la corsa compaiono <strong>gettoni con le lettere</strong>: completa la parola e San Rocco
      cambia mezzo per qualche secondo, con comandi e fisica diversi.
      Se vieni colpito mentre sei trasformato <strong>perdi il mezzo, non la partita</strong>.
    </p>
  </div>
  <div class="jp-legend-grid">
    <div class="jp-veh v-cane">
      <span class="jp-veh-word">C·A·N·E</span>
      <h4>Cane Fedele</h4>
      <p>Il bulldozer di terra: <strong>salto triplo</strong>, <strong>sfonda i raggi</strong> che tocchi,
         onda d'urto all'atterraggio e fedeli travolti a <strong>punti tripli</strong>. Occhio ai missili.</p>
    </div>
    <div class="jp-veh v-razzo">
      <span class="jp-veh-word">F·U·O·C·O</span>
      <h4>Razzo di Fuoco</h4>
      <p>Diventi un razzo: <strong>sfondi raggi e missili</strong> e corri molto più veloce.</p>
    </div>
    <div class="jp-veh v-vino">
      <span class="jp-veh-word">V·I·N·O</span>
      <h4>Brocca di Vino</h4>
      <p>Galleggi leggero, <strong>rimbalzi</strong> su cielo e terra e <strong>attiri le monete</strong> come una calamita.</p>
    </div>
    <div class="jp-veh v-santo">
      <span class="jp-veh-word">S·A·N·T·O</span>
      <h4>Santo in Gloria</h4>
      <p>Niente spinta: ogni tocco <strong>inverte la gravità</strong>: cadi verso il cielo o verso terra.</p>
    </div>
  </div>
</section>
