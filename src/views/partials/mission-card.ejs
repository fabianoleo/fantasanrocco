<%# ── Una card missione ────────────────────────────────────────────────────
    Locals: m (la missione), sbircia (true se chi guarda è staff e quindi
    riceve anche i testi delle sfide non ancora uscite).

    Una missione bloccata è coperta. Per i giocatori il velo non è solo
    grafica: titolo e descrizione non arrivano proprio nell'HTML, quindi non
    si leggono nemmeno con gli strumenti da sviluppatore. Allo staff invece
    arrivano, coperti da una sfocatura che il pulsante «sbircia» toglie —
    serve a rileggere i testi prima che escano.
    ───────────────────────────────────────────────────────────────────── %>
<% if (m.locked) { %>
  <div class="mission-card is-locked <%= sbircia ? 'ms-sbirciabile' : '' %>"
       aria-label="Missione bloccata, rarità <%= m.rarity.label %>, <%= m.points %> punti<%= m.unlockLabel ? ', si sblocca il ' + m.unlockLabel : '' %>">
    <div class="mission-head">
      <span class="rar-chip rar-<%= m.rarity.key %>"><span class="rar-dot" aria-hidden="true"><%= m.rarity.emoji %></span> <%= m.rarity.label %></span>
      <span class="points-badge"><%= m.points %> pt</span>
    </div>
    <% if (sbircia) { %>
      <%# Il contenuto vero, sotto il velo. Lo vede solo lo staff. %>
      <div class="mlock-vero">
        <h3 class="m-name"><%= m.rarity.name %></h3>
        <p class="mission-desc"><%= m.description %></p>
      </div>
    <% } else { %>
      <div class="mlock-skel" aria-hidden="true"><span></span><span></span><span></span></div>
    <% } %>
    <div class="mission-meta">
      <span class="tag tag-off"><%- icon('lock') %> <%= m.unlockLabel ? 'Si sblocca il ' + m.unlockLabel : 'Non ancora disponibile' %></span>
    </div>
  </div>
<% } else { %>
  <a class="mission-card <%= m.activeNow ? '' : 'inactive' %>" href="/missioni/<%= m.id %>">
    <div class="mission-head">
      <h3><span class="m-bonus">BONUS</span> <span class="m-name"><%= m.rarity.name %></span></h3>
      <span class="points-badge"><%= m.points %> pt</span>
    </div>
    <%# Il marchio di chi mette la missione, quando c'è. Sta fra il titolo e
        il testo perché è un'attribuzione, non un tag: dirlo dopo la
        descrizione sembrerebbe una firma in calce. %>
    <% if (m.sponsorSrc) { %>
      <p class="mission-sponsor">
        <img src="<%= m.sponsorSrc %>" alt="<%= m.sponsorNome %>" loading="lazy">
        <span>Missione di <strong><%= m.sponsorNome %></strong></span>
      </p>
    <% } %>
    <p class="mission-desc"><%= m.description %></p>
    <div class="mission-meta">
      <% if (m.rarity.label) { %><span class="rar-chip rar-<%= m.rarity.key %>"><span class="rar-dot" aria-hidden="true"><%= m.rarity.emoji %></span> <%= m.rarity.label %></span><% } %>
      <% if (m.hasApproved && !m.repeatable) { %>
        <span class="tag tag-ok"><%- icon('check-circle') %> Fatta oggi</span>
      <% } else if (m.hasPending) { %>
        <span class="tag tag-pending"><%- icon('hourglass') %> In attesa</span>
      <% } %>
      <% if (m.repeatable) { %><span class="tag"><%- icon('repeat') %> Ripetibile</span><% } %>
      <% if (m.requires_photo) { %><span class="tag"><%- icon('camera') %> Foto</span><% } %>
      <% if (m.expired) { %>
        <span class="tag tag-off"><%- icon('alarm') %> Scaduta</span>
      <% } else { %>
        <span class="tag tag-live"><%- icon('dot') %> Attiva</span>
      <% } %>
    </div>
    <div class="mission-counter">
      <span class="mc-icon"><%- icon('people') %></span>
      <span class="mc-val"><%= m.completedBy %></span>
      <span class="mc-label"><%= m.completedBy === 1 ? 'persona ha completato' : 'persone hanno completato' %></span>
    </div>
  </a>
<% } %>
