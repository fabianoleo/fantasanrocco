<%
  // Variabili condivise (usate sia nelle tile che nei pannelli)
  const codeList   = (typeof codes !== 'undefined' && codes) ? codes : [];
  const reports    = (typeof reportedStories !== 'undefined' && reportedStories) ? reportedStories : [];
  const backupList = (typeof backups !== 'undefined' && backups) ? backups : [];
  const logRows    = (typeof auditLog !== 'undefined' && auditLog) ? auditLog : [];
  const pronoStatus = (typeof pronostico !== 'undefined' && pronostico)
    ? (pronostico.resolved ? 'chiuso' : (pronostico.open ? 'aperto' : 'in pausa'))
    : null;
%>

<h1 class="staff-title"><%- icon(soloMissioni ? 'list' : 'gear') %> <%= soloMissioni ? 'Pannello Staff' : 'Pannello Admin' %></h1>
<% if (soloMissioni) { %><p class="muted small">Da qui gestisci le missioni e leggi le segnalazioni degli utenti. Il resto del pannello è riservato agli admin.</p><% } %>

<%# ══════════════ HUB: tutte le cose principali a colpo d'occhio ══════════════ %>
<div class="adm-hub" id="admHub">

  <button type="button" class="adm-tile" data-panel="missioni">
    <span class="adm-tile-ico"><%- icon('list') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Missioni</span>
      <span class="adm-tile-desc">Crea, modifica e archivia le missioni</span>
    </span>
    <span class="adm-tile-badge"><%= missions.length %></span>
  </button>
  <button type="button" class="adm-tile" data-panel="segnalazioni-utenti">
    <span class="adm-tile-ico"><%- icon('mail') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Segnalazioni dal sito</span>
      <span class="adm-tile-desc">Bug e idee mandati dagli utenti</span>
    </span>
    <% const sgNuove = (segnalazioni || []).filter((s) => !s.letta).length; %>
    <% if (sgNuove) { %><span class="adm-tile-badge is-alert"><%= sgNuove %></span><% } %>
  </button>

  <% if (!soloMissioni) { %>

  <button type="button" class="adm-tile" data-panel="premi">
    <span class="adm-tile-ico"><%- icon('gift') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Codici premio</span>
      <span class="adm-tile-desc">Genera e stampa i QR premio</span>
    </span>
    <span class="adm-tile-badge"><%= codeList.length %></span>
  </button>

  <button type="button" class="adm-tile" data-panel="notifiche">
    <span class="adm-tile-ico"><%- icon('bell') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Notifiche push</span>
      <span class="adm-tile-desc">Invia un avviso a tutti</span>
    </span>
  </button>

  <% if (typeof pronostico !== 'undefined' && pronostico) { %>
  <button type="button" class="adm-tile" data-panel="pronostico">
    <span class="adm-tile-ico"><%- icon('fireworks') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Pronostico Palio</span>
      <span class="adm-tile-desc"><%= pronostico.totalVotes %> pronostici · <%= pronoStatus %></span>
    </span>
  </button>
  <% } %>

  <button type="button" class="adm-tile" data-panel="pronostici">
    <span class="adm-tile-ico"><%- icon('target') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Pronostici</span>
      <span class="adm-tile-desc">Crea pronostici personalizzati</span>
    </span>
    <% if (typeof predictions !== 'undefined' && predictions.length) { %><span class="adm-tile-badge"><%= predictions.length %></span><% } %>
  </button>

  <button type="button" class="adm-tile" data-panel="utenti">
    <span class="adm-tile-ico"><%- icon('people') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Utenti e ruoli</span>
      <span class="adm-tile-desc">Ruoli, email, punti bonus, cancellazione</span>
    </span>
    <span class="adm-tile-badge"><%= users.length %></span>
  </button>

  <button type="button" class="adm-tile" data-panel="segnalazioni">
    <span class="adm-tile-ico"><%- icon('warning') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Storie segnalate</span>
      <span class="adm-tile-desc">Modera i contenuti segnalati</span>
    </span>
    <% if (reports.length) { %><span class="adm-tile-badge is-alert"><%= reports.length %></span><% } %>
  </button>

  <button type="button" class="adm-tile" data-panel="backup">
    <span class="adm-tile-ico"><%- icon('save') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Backup database</span>
      <span class="adm-tile-desc">Snapshot e download</span>
    </span>
    <span class="adm-tile-badge"><%= backupList.length %></span>
  </button>

  <button type="button" class="adm-tile" data-panel="log">
    <span class="adm-tile-ico"><%- icon('list') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Registro azioni</span>
      <span class="adm-tile-desc">Chi ha fatto cosa</span>
    </span>
  </button>

  <a class="adm-tile" href="/admin/statistiche">
    <span class="adm-tile-ico"><%- icon('chart') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Statistiche</span>
      <span class="adm-tile-desc">Attività dei giocatori · grafici</span>
    </span>
  </a>

  <a class="adm-tile" href="/admin/prove.csv">
    <span class="adm-tile-ico"><%- icon('save') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Scarica i dati delle prove</span>
      <span class="adm-tile-desc">CSV con data di scatto, dispositivo, impronta</span>
    </span>
  </a>

  <a class="adm-tile" href="/2fa">
    <span class="adm-tile-ico"><%- icon('lock') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Sicurezza (2FA)</span>
      <span class="adm-tile-desc">Verifica in due passaggi</span>
    </span>
  </a>

  <button type="button" class="adm-tile" data-panel="jetpack">
    <span class="adm-tile-ico"><%- icon('fireworks') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">San Rocco Jetpack</span>
      <span class="adm-tile-desc">Nuovo mini-gioco pixel · anteprima</span>
    </span>
    <span class="adm-tile-badge">beta</span>
  </button>

  <button type="button" class="adm-tile" data-panel="iscrizioni">
    <span class="adm-tile-ico"><%- icon('lock') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Settimana di sole iscrizioni</span>
      <span class="adm-tile-desc">Apri e chiudi il resto dell'app</span>
    </span>
    <% if (soloIscrizioni) { %><span class="adm-tile-badge">attiva</span><% } %>
  </button>

  <button type="button" class="adm-tile adm-tile-danger" data-panel="reset">
    <span class="adm-tile-ico"><%- icon('bolt') %></span>
    <span class="adm-tile-body">
      <span class="adm-tile-title">Reset Gioco</span>
      <span class="adm-tile-desc">Azzera i dati di gioco · solo test</span>
    </span>
  </button>

  <% } %>
</div>

<%# ══════════════ PANNELLI DI DETTAGLIO (uno visibile alla volta) ══════════════ %>

<%# ── MISSIONI ─────────────────────────────────────────────────────── %>
<div class="adm-panel" id="p-missioni" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card">
    <h2 class="staff-title"><%- icon('plus') %> Nuova missione</h2>
    <form action="/admin/missioni" method="post" class="mission-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Titolo
        <input type="text" name="title" required placeholder="es. 🥃 Shot con Zio Max">
      </label>
      <label>Descrizione
        <textarea name="description" rows="2" placeholder="Cosa deve fare il partecipante"></textarea>
      </label>
      <div class="row">
        <label>Punti
          <input type="number" name="points" value="50" min="0">
        </label>
        <label class="check"><input type="checkbox" name="requires_photo" checked> Richiede foto</label>
        <label class="check"><input type="checkbox" name="repeatable"> Ripetibile</label>
        <% if (!soloMissioni) { %><label class="check"><input type="checkbox" name="notify"> 🔔 Avvisa tutti</label><% } %>
      </div>
      <div class="row">
        <label>Attiva da (facoltativo)
          <input type="datetime-local" name="active_from">
        </label>
        <label>Attiva fino a (facoltativo)
          <input type="datetime-local" name="active_to">
        </label>
      </div>
      <div class="row">
        <label class="field-grow">Sezione (conta per il bonus da 100 punti)
          <select name="section">
            <option value="">Nessuna — sfida speciale</option>
            <% (typeof sezioni !== 'undefined' ? sezioni : []).forEach((s) => { %>
              <option value="<%= s.key %>"><%= s.label %></option>
            <% }) %>
          </select>
        </label>
        <label class="field-grow">Uscita programmata (facoltativo) — per le missioni flash
          <input type="text" name="publish_at" placeholder="2026-08-17 23:45">
        </label>
      </div>
      <div class="row">
        <%# In elenco solo gli sponsor col PNG gia' in casa: sceglierne uno
            senza file metterebbe un'immagine rotta sulla card. %>
        <label class="field-grow">Sponsor della missione (facoltativo) — il marchio compare sulla card
          <select name="sponsor">
            <option value="">Nessuno — missione della festa</option>
            <% (typeof sponsorPerMissione !== 'undefined' ? sponsorPerMissione : []).forEach((s) => { %>
              <option value="<%= s.file %>"><%= s.nome %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <p class="muted small mission-hint">
        <%- icon('alarm') %> Metti qui un orario e la missione nasce <strong>nascosta</strong>: esce da sola
        a quell'ora, con la notifica a tutti. Così prepari le flash con giorni di anticipo.
      </p>
      <button class="btn" type="submit">Crea missione</button>
    </form>
  </section>

  <section class="card">
    <h2 class="staff-title"><%- icon('list') %> Missioni esistenti (<%= missions.length %>)</h2>
    <p class="muted small" style="margin:-.4rem 0 .8rem">
      Divise per giorno, in ordine crescente. Ci sono anche le <strong>flash</strong>
      (<span class="mission-state mission-state-flash"><%- icon('bolt') %></span> = nascosta agli utenti):
      stanno nel giorno in cui vanno sbloccate.
    </p>
    <% (typeof gruppiMissioni !== 'undefined' ? gruppiMissioni : [{ etichetta: '', missioni: missions }]).forEach((gr) => { %>
      <h3 class="adm-giorno"><%= gr.etichetta %> <span class="adm-giorno-n"><%= gr.missioni.length %></span></h3>
      <% gr.missioni.forEach((m) => { %>
      <details class="admin-mission">
        <summary>
          <span>
            <%# Due stati diversi, due simboli diversi: "archiviata" (flash o
                manuale) sparisce del tutto dalla pagina pubblica; "bloccata"
                invece si vede sfocata con solo la rarità, in attesa del suo
                orario. Confonderli in admin fa perdere il conto di cosa è
                davvero nascosto e cosa uscirà da solo. %>
            <% if (m.archived) { %>
              <span class="mission-state mission-state-flash" title="Archiviata: invisibile agli utenti"><%- icon('bolt') %></span>
            <% } else if (m.locked) { %>
              <span class="mission-state mission-state-locked" title="Bloccata: visibile solo sfocata, in attesa dell'orario"><%- icon('lock') %></span>
            <% } %>
            <%= m.title %>
            <% if (m.publish_at) { %><span class="mission-sched"><%- icon('alarm') %> esce il <%= m.publish_at %></span><% } %>
          </span>
          <span class="points-badge"><%= m.points %> pt</span>
        </summary>
        <form action="/admin/missioni/<%= m.id %>/modifica" method="post" class="mission-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Titolo<input type="text" name="title" value="<%= m.title %>" required></label>
          <label>Descrizione<textarea name="description" rows="2"><%= m.description %></textarea></label>
          <div class="row">
            <label>Punti<input type="number" name="points" value="<%= m.points %>" min="0"></label>
            <label class="check"><input type="checkbox" name="requires_photo" <%= m.requires_photo ? 'checked' : '' %>> Foto</label>
            <label class="check"><input type="checkbox" name="repeatable" <%= m.repeatable ? 'checked' : '' %>> Ripetibile</label>
            <label class="check"><input type="checkbox" name="archived" <%= m.archived ? 'checked' : '' %>> Archivia</label>
            <% if (!soloMissioni) { %><label class="check"><input type="checkbox" name="notify" checked> 🔔 Avvisa tutti quando esce</label><% } %>
          </div>
          <div class="row">
            <label>Attiva da<input type="text" name="active_from" value="<%= m.active_from || '' %>" placeholder="2026-08-16 18:00"></label>
            <label>Attiva fino a<input type="text" name="active_to" value="<%= m.active_to || '' %>" placeholder="2026-08-17 03:00"></label>
          </div>
          <div class="row">
            <label class="field-grow">Sezione
              <select name="section">
                <option value="">Nessuna — sfida speciale</option>
                <% (typeof sezioni !== 'undefined' ? sezioni : []).forEach((s) => { %>
                  <option value="<%= s.key %>" <%= m.section === s.key ? 'selected' : '' %>><%= s.label %></option>
                <% }) %>
              </select>
            </label>
            <label class="field-grow">Uscita programmata (lascia vuoto per gestirla a mano)
              <input type="text" name="publish_at" value="<%= m.publish_at || '' %>" placeholder="2026-08-17 23:45">
            </label>
          </div>
          <div class="row">
            <label class="field-grow">Sponsor della missione
              <select name="sponsor">
                <option value="">Nessuno — missione della festa</option>
                <% (typeof sponsorPerMissione !== 'undefined' ? sponsorPerMissione : []).forEach((s) => { %>
                  <option value="<%= s.file %>" <%= m.sponsor === s.file ? 'selected' : '' %>><%= s.nome %></option>
                <% }) %>
              </select>
            </label>
          </div>
          <p class="muted small mission-hint">
            <%- icon('alarm') %> Con un orario qui, la missione resta archiviata fino a quel momento, poi esce
            da sola e parte la notifica. Senza orario, esce quando togli la spunta <strong>Archivia</strong>
            (e la notifica parte lo stesso, a meno che tu non tolga <strong>Avvisa tutti</strong>).
          </p>
          <div class="mod-actions">
            <button class="btn" type="submit"><%- icon('save') %> Salva</button>
          </div>
        </form>
        <form action="/admin/missioni/<%= m.id %>/elimina" method="post" class="danger-form"
              data-confirm="Eliminare definitivamente questa missione e le sue prove?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-no" type="submit"><%- icon('trash') %> Elimina</button>
        </form>
      </details>
      <% }) %>
    <% }) %>
  </section>
</div>

<%# ── CODICI PREMIO ────────────────────────────────────────────────── %>
<%# ── BACKUP DATABASE ──────────────────────────────────────────────── %>
<%# ── SEGNALAZIONI DAGLI UTENTI ─────────────────────────────────────── %>
<div class="adm-panel" id="p-segnalazioni-utenti" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>
  <section class="card">
    <h2 class="staff-title"><%- icon('mail') %> Segnalazioni dal sito</h2>
    <p class="muted small">
      Arrivano dal tasto «Segnala un problema» nel footer. Sono in ordine: prima le
      non lette, poi le altre. La pagina e il telefono di chi scrive li registra il
      browser da solo — senza quelli metà dei guasti non si riesce a rifare.
    </p>
    <% if (!(segnalazioni || []).length) { %>
      <p class="muted small">Nessuna segnalazione. Buon segno.</p>
    <% } else { %>
      <% segnalazioni.forEach(function (s) { %>
        <article class="sg-riga <%= s.letta ? 'is-letta' : '' %>">
          <div class="sg-riga-top">
            <span class="sg-tag sg-tag-<%= s.tipo %>"><%= s.tipo === 'bug' ? 'Non funziona' : s.tipo === 'idea' ? 'Idea' : 'Altro' %></span>
            <span class="sg-chi"><%= s.nickname || 'anonimo' %></span>
            <span class="sg-quando"><%= oraItaliana(s.created_at) %></span>
          </div>
          <p class="sg-testo"><%= s.testo %></p>
          <p class="sg-meta">
            <% if (s.pagina) { %>da <code><%= s.pagina %></code><% } %>
            <% if (s.agente) { %> · <span title="<%= s.agente %>"><%= s.agente.slice(0, 60) %></span><% } %>
          </p>
          <form action="/admin/segnalazioni/<%= s.id %>/letta" method="post" class="sg-riga-azione">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn-mini" type="submit"><%= s.letta ? 'Segna da rileggere' : 'Segna come letta' %></button>
          </form>
        </article>
      <% }) %>
    <% } %>
  </section>
</div>

<% if (!soloMissioni) { %>
<div class="adm-panel" id="p-premi" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card">
    <h2 class="staff-title"><%- icon('gift') %> Codici premio (link / QR)</h2>
    <p class="muted small">
      Genera uno o più QR premio: il <strong>primo utente loggato</strong> che scansiona un QR riceve i punti,
      chi arriva dopo non guadagna nulla. Ogni QR è <strong>monouso</strong> — creane quanti te ne servono, tutti
      dello stesso valore, e stampali ai vari punti della festa.
    </p>
    <form action="/admin/codici" method="post" class="mission-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row">
        <label>Punti in palio
          <input type="number" name="points" value="50" min="1" required>
        </label>
        <label style="width:130px">Quanti QR
          <input type="number" name="quantity" value="1" min="1" max="100" title="Da 1 a 100 QR in un colpo">
        </label>
        <label style="flex:1 1 200px">Etichetta (facoltativa, solo per te)
          <input type="text" name="label" placeholder="es. QR stand gadget">
        </label>
      </div>
      <button class="btn" type="submit"><%- icon('plus') %> Genera QR premio</button>
    </form>

    <% if (codeList.length) { %>
      <p class="muted small" style="margin-top:.4rem"><%= codeList.length %> QR totali · usa <kbd>Ctrl/Cmd + P</kbd> per stamparli.</p>
      <div class="reward-grid">
        <% codeList.forEach((c) => { %>
          <div class="reward-qr <%= c.claimed_by ? 'is-used' : '' %>" data-code="<%= c.code %>">
            <div class="reward-qr-img"><%- c.qrSvg %></div>
            <div class="reward-qr-meta">
              <span class="points-badge"><%= c.points %> pt</span>
              <% if (c.claimed_by) { %>
                <span class="tag tag-off">usato<% if (c.claimer) { %> · <%= c.claimer %><% } %></span>
              <% } else { %>
                <span class="tag tag-on">libero</span>
              <% } %>
            </div>
            <div class="reward-qr-code"><% if (c.label) { %><strong><%= c.label %></strong> · <% } %>/r/<%= c.code %></div>
            <div class="reward-qr-actions">
              <button type="button" class="btn-mini qr-dl"><%- icon('save') %> Scarica</button>
              <button type="button" class="btn-mini qr-copy"><%- icon('camera') %> Copia</button>
            </div>
            <form action="/admin/codici/<%= c.code %>/elimina" method="post" class="reward-qr-del"
                  data-confirm="Eliminare questo QR premio?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn-mini" type="submit" aria-label="Elimina QR"><%- icon('trash') %></button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="muted small">Nessun QR premio ancora. Creane qui sopra.</p>
    <% } %>
  </section>
</div>

<%# ── NOTIFICHE PUSH ───────────────────────────────────────────────── %>
<div class="adm-panel" id="p-notifiche" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card">
    <h2 class="staff-title"><%- icon('bell') %> Invia una notifica</h2>
    <p class="muted small">Arriva a tutti quelli che hanno attivato gli avvisi (app installata). Es. «Il Palio dei Fuochi inizia tra 30 minuti!».</p>
    <form action="/admin/push" method="post" class="mission-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Titolo
        <input type="text" name="title" maxlength="80" placeholder="FantaSanRocco" value="FantaSanRocco">
      </label>
      <label>Messaggio
        <input type="text" name="body" maxlength="180" required placeholder="Il Palio dei Fuochi inizia tra 30 minuti!">
      </label>
      <label>Apri alla pagina (facoltativo)
        <input type="text" name="url" placeholder="/programmazione" value="/">
      </label>
      <button class="btn" type="submit">Invia notifica</button>
    </form>
  </section>

  <section class="card">
    <h2 class="staff-title"><%- icon('camera') %> Avvisi nuove prove <span class="tag <%= notifSubmissions ? 'tag-on' : 'tag-off' %>"><%= notifSubmissions ? 'attivi' : 'disattivi' %></span></h2>
    <p class="muted small">
      Ricevi una notifica push <strong>solo per te</strong> ogni volta che un utente carica una prova da validare.
      È una <strong>categoria separata</strong>: puoi spegnerla senza perdere le altre notifiche.
      Serve comunque avere le notifiche del dispositivo attive.
    </p>
    <form action="/admin/notifiche-prove" method="post" class="mission-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="check"><input type="checkbox" name="notif_submissions" value="1" <%= notifSubmissions ? 'checked' : '' %>> Avvisami a ogni nuova prova caricata</label>
      <button class="btn" type="submit"><%- icon('save') %> Salva preferenza</button>
    </form>
  </section>
</div>

<% if (typeof pronostico !== 'undefined' && pronostico) { %>
<%# ── PRONOSTICO PALIO ─────────────────────────────────────────────── %>
<div class="adm-panel" id="p-pronostico" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card">
    <h2 class="staff-title"><%- icon('fireworks') %> Pronostico Palio dei Fuochi</h2>
    <p class="muted small">
      Gli utenti scelgono un fuochista dalla pagina Missioni. Dichiara il vincitore
      e i punti vengono accreditati automaticamente a chi ha indovinato.
      <strong><%= pronostico.totalVotes %></strong> pronostici totali ·
      <% if (pronostico.resolved) { %>
        <span class="tag tag-off">chiuso · vincitore dichiarato</span>
      <% } else if (pronostico.open) { %>
        <span class="tag tag-on">votazioni aperte</span>
      <% } else { %>
        <span class="tag tag-off">votazioni chiuse (nessun vincitore)</span>
      <% } %>
    </p>

    <%# Distribuzione voti %>
    <div class="prono-admin-dist">
      <% pronostico.fuochisti.forEach((f, i) => {
           const pct = pronostico.totalVotes ? Math.round(f.votes / pronostico.totalVotes * 100) : 0; %>
        <div class="prono-adist-row <%= pronostico.winner === i ? 'is-winner' : '' %>">
          <span class="prono-adist-name"><%= i + 1 %>. <%= f.short %><% if (pronostico.winner === i) { %> <%- icon('trophy') %><% } %></span>
          <span class="prono-adist-bar"><span style="width:<%= pct %>%"></span></span>
          <span class="prono-adist-val"><%= f.votes %> · <%= pct %>%</span>
        </div>
      <% }) %>
    </div>

    <% if (!pronostico.resolved) { %>
      <%# Impostazioni: apri/chiudi + punti %>
      <form action="/admin/pronostico/impostazioni" method="post" class="mission-form" style="margin-top:1rem">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row">
          <label>Punti in palio
            <input type="number" name="points" value="<%= pronostico.points %>" min="0" step="1">
          </label>
          <label class="check"><input type="checkbox" name="open" value="1" <%= pronostico.open ? 'checked' : '' %>> Votazioni aperte</label>
        </div>
        <label>Chiusura programmata (facoltativa) — avvisa chi non ha votato ~3h prima
          <input type="text" name="closes_at" value="<%= pronostico.closesAt || '' %>" placeholder="2026-08-18 19:30">
        </label>
        <button class="btn" type="submit"><%- icon('save') %> Salva impostazioni</button>
      </form>

      <%# Dichiara il vincitore %>
      <form action="/admin/pronostico/vincitore" method="post" class="mission-form" style="margin-top:1rem"
            data-confirm="Dichiarare questo fuochista vincitore e accreditare i punti a chi ha indovinato?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Fuochista vincitore
          <select name="winner" required>
            <option value="" disabled selected>— scegli il vincitore —</option>
            <% pronostico.fuochisti.forEach((f, i) => { %>
              <option value="<%= i %>"><%= i + 1 %>. <%= f.name %></option>
            <% }) %>
          </select>
        </label>
        <button class="btn btn-no" type="submit"><%- icon('trophy') %> Dichiara vincitore e assegna punti</button>
      </form>
    <% } else { %>
      <p class="muted small" style="margin-top:1rem">
        Vincitore attuale: <strong><%= pronostico.fuochisti[pronostico.winner].name %></strong>.
        Per correggere, annulla il pronostico (storna i punti e riapre le votazioni).
      </p>
      <form action="/admin/pronostico/reset" method="post" class="danger-form"
            data-confirm="Annullare il pronostico? Verranno stornati i punti assegnati e riaperte le votazioni.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-no" type="submit"><%- icon('repeat') %> Annulla pronostico e storna punti</button>
      </form>
    <% } %>
  </section>
</div>
<% } %>

<%# ── PRONOSTICI GENERICI ──────────────────────────────────────────── %>
<div class="adm-panel" id="p-pronostici" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card">
    <h2 class="staff-title"><%- icon('plus') %> Nuovo pronostico</h2>
    <p class="muted small">Crea un pronostico personalizzato: comparirà come card nella pagina Missioni.
      Gli utenti scelgono un'opzione; quando dichiari l'esito, chi indovina riceve i punti.</p>
    <form action="/admin/pronostici" method="post" class="mission-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Domanda
        <input type="text" name="title" required maxlength="140" placeholder="es. Chi vince la gara di ballo?">
      </label>
      <label>Descrizione (facoltativa)
        <textarea name="description" rows="2" maxlength="400" placeholder="Se la lasci vuota, viene usato un testo di default."></textarea>
      </label>
      <label>Opzioni (una per riga, min. 2)
        <textarea name="options" rows="4" required placeholder="Squadra Rossa&#10;Squadra Blu&#10;Squadra Verde"></textarea>
      </label>
      <div class="row">
        <label style="max-width:160px">Punti a chi indovina
          <input type="number" name="points" value="100" min="0" step="1">
        </label>
        <label class="check"><input type="checkbox" name="multi" value="1"> Consenti più risposte</label>
      </div>
      <label>Chiusura programmata (facoltativa) — avvisa chi non ha votato ~3h prima
        <input type="text" name="closes_at" placeholder="2026-08-16 20:00">
      </label>
      <p class="muted small" style="margin-top:-.3rem">Con più risposte consentite, chi ne seleziona più d'una prende <strong>metà punti</strong> se indovina.</p>
      <button class="btn" type="submit"><%- icon('plus') %> Crea pronostico</button>
    </form>
  </section>

  <% if (typeof predictions !== 'undefined' && predictions.length) { %>
    <% predictions.forEach((p) => { %>
      <section class="card">
        <h2 class="staff-title"><%- icon('target') %> <%= p.title %>
          <%# «in cantiere» viene prima di tutto: se i giocatori non lo vedono,
              sapere che è «aperto» non serve a niente. %>
          <% if (p.archived) { %><span class="tag tag-off">in cantiere · non si vede</span>
          <% } else if (p.resolved) { %><span class="tag tag-off">chiuso · esito dichiarato</span>
          <% } else if (p.open) { %><span class="tag tag-on">aperto</span>
          <% } else { %><span class="tag tag-off">chiuso</span><% } %>
          <% if (p.multi) { %><span class="tag">più risposte</span><% } %>
        </h2>

        <%# ── Pubblica / rimetti in cantiere ──────────────────────────────
            La notifica è una SPUNTA, non un automatismo: si pubblica anche
            per controllare che si veda bene, e di notte non si suona il
            telefono a tutto il paese. %>
        <form action="/admin/pronostici/<%= p.id %>/pubblica" method="post" class="prono-pub"
              data-confirm="<%= p.archived ? 'Pubblicare questo pronostico? Diventa visibile a tutti i giocatori.' : 'Rimettere in cantiere? I giocatori non lo vedranno più.' %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="pubblica" value="<%= p.archived ? '1' : '0' %>">
          <% if (p.archived) { %>
            <label class="check prono-pub-avvisa">
              <input type="checkbox" name="notify" value="1"> 🔔 Avvisa tutti quando esce
            </label>
            <button class="btn-mini btn-ok" type="submit"><%- icon('bell') %> Pubblica</button>
          <% } else { %>
            <button class="btn-mini" type="submit"><%- icon('lock') %> Rimetti in cantiere</button>
          <% } %>
        </form>
        <p class="muted small"><strong><%= p.totalVotes %></strong> voti · <%= p.points %> punti in palio<% if (p.multi) { %> · più risposte = metà punti<% } %></p>

        <div class="prono-admin-dist">
          <% p.options.forEach((o, i) => {
               const pct = p.totalVotes ? Math.round(o.votes / p.totalVotes * 100) : 0; %>
            <div class="prono-adist-row <%= p.winner === i ? 'is-winner' : '' %>">
              <span class="prono-adist-name"><%= i + 1 %>. <%= o.name %><% if (p.winner === i) { %> <%- icon('trophy') %><% } %></span>
              <span class="prono-adist-bar"><span style="width:<%= pct %>%"></span></span>
              <span class="prono-adist-val"><%= o.votes %> · <%= pct %>%</span>
            </div>
          <% }) %>
        </div>

        <% if (!p.resolved) { %>
          <form action="/admin/pronostici/<%= p.id %>/impostazioni" method="post" class="mission-form" style="margin-top:1rem">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row">
              <label>Punti in palio<input type="number" name="points" value="<%= p.points %>" min="0" step="1"></label>
              <label class="check"><input type="checkbox" name="open" value="1" <%= p.open ? 'checked' : '' %>> Votazioni aperte</label>
            </div>
            <label>Chiusura programmata (facoltativa)
              <input type="text" name="closes_at" value="<%= p.closesAt || '' %>" placeholder="2026-08-16 20:00">
            </label>
            <button class="btn" type="submit"><%- icon('save') %> Salva impostazioni</button>
          </form>

          <form action="/admin/pronostici/<%= p.id %>/vincitore" method="post" class="mission-form" style="margin-top:1rem"
                data-confirm="Dichiarare questa opzione vincente e accreditare i punti a chi ha indovinato?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label>Opzione vincente
              <select name="winner" required>
                <option value="" disabled selected>— scegli l'esito —</option>
                <% p.options.forEach((o, i) => { %><option value="<%= i %>"><%= i + 1 %>. <%= o.name %></option><% }) %>
              </select>
            </label>
            <button class="btn btn-no" type="submit"><%- icon('trophy') %> Dichiara esito e assegna punti</button>
          </form>
        <% } else { %>
          <p class="muted small" style="margin-top:1rem">Esito attuale: <strong><%= p.options[p.winner].name %></strong>. Per correggere, annulla (storna i punti).</p>
          <form action="/admin/pronostici/<%= p.id %>/reset" method="post" class="danger-form"
                data-confirm="Annullare questo pronostico? Verranno stornati i punti e riaperte le votazioni.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-no" type="submit"><%- icon('repeat') %> Annulla e storna punti</button>
          </form>
        <% } %>

        <form action="/admin/pronostici/<%= p.id %>/elimina" method="post" class="danger-form" style="margin-top:.8rem"
              data-confirm="Eliminare definitivamente questo pronostico e tutti i suoi voti? I punti assegnati verranno stornati.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn-mini" type="submit"><%- icon('trash') %> Elimina pronostico</button>
        </form>
      </section>
    <% }) %>
  <% } else { %>
    <section class="card"><p class="muted small">Nessun pronostico personalizzato ancora. Creane uno qui sopra.</p></section>
  <% } %>
</div>

<%# ── UTENTI E RUOLI ───────────────────────────────────────────────── %>
<div class="adm-panel" id="p-utenti" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <%# ── CHI GUADAGNA DAGLI INVITI ────────────────────────────────────
      Sta PRIMA dell'elenco utenti perche' e' un controllo, non una scheda:
      lo si apre per guardare questa, e l'elenco completo e' sotto.
      Il conteggio che conta e' «mai giocato»: un account creato solo per
      regalare punti a chi l'ha creato non gira la Ruota e non manda prove. %>
  <section class="card">
    <h2 class="staff-title"><%- icon('people') %> Punti dagli inviti · primi <%= classificaInviti.length %></h2>
    <p class="muted small">Ogni amico portato vale <strong>+<%= puntiInvito %> punti</strong>, ma solo quando
      arriva a <strong><%= sogliaInvito %> punti</strong>: gli amici ancora sotto soglia sono in grigio e non
      hanno pagato niente. Da guardare restano i <strong>mai giocato</strong> — a un account fabbricato la
      soglia non la fa arrivare nessuno, ma vederli in fila dice comunque cosa stava provando a fare
      chi li ha creati. Utile anche l'ora: dieci amici arrivati nello stesso minuto sono un'altra
      cosa da dieci arrivati in tre giorni.</p>

    <% if (!classificaInviti.length) { %>
      <p class="muted small">Nessuno ha ancora portato amici.</p>
    <% } else { %>
      <ul class="user-list">
        <% classificaInviti.forEach((r, i) => { %>
          <li class="user-row <%= r.maiGiocatoQuanti ? 'inv-sospetto' : '' %>">
            <div class="user-head">
              <span class="inv-pos"><%= i + 1 %></span>
              <span class="user-name"><%= r.nickname %></span>
              <span class="role-badge role-<%= r.role %>"><%= r.role %></span>
              <span class="user-pts"><%= r.punti %> pt · <%= r.pagati %>/<%= r.quanti %> a segno</span>
              <% if (r.maiGiocatoQuanti) { %>
                <span class="tag tag-off"><%- icon('warning') %> <%= r.maiGiocatoQuanti %> mai <%= r.maiGiocatoQuanti === 1 ? 'giocato' : 'giocati' %></span>
              <% } %>
              <a class="user-storico" href="/admin/punti/<%= r.id %>"><%- icon('list') %> Storico</a>
            </div>
            <p class="inv-chi">
              <% r.invitati.forEach((a) => { %>
                <span class="inv-amico <%= a.maiGiocato ? 'is-fermo' : '' %> <%= a.pagato ? 'is-pagato' : '' %>"
                      title="<%= a.pagato ? 'Ha superato la soglia: bonus pagato' : (a.maiGiocato ? 'Nessuna prova inviata e saldo a zero' : 'Sta giocando, soglia non ancora raggiunta') %>">
                  <%= a.nickname %>
                  <small><%= oraItaliana(a.quando) %></small>
                </span>
              <% }) %>
            </p>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <%# ── EMAIL BLOCCATE ───────────────────────────────────────────────
      L'indirizzo non c'e' piu' in chiaro da nessuna parte: cancellare un
      account e' il diritto all'oblio. Qui resta mascherato, quanto basta a
      riconoscere una riga e a sbloccarla se la spunta e' andata storta. %>
  <% if (emailBloccate.length) { %>
    <section class="card">
      <h2 class="staff-title"><%- icon('lock') %> Email che non possono iscriversi (<%= emailBloccate.length %>)</h2>
      <p class="muted small">Bloccate cancellando un account con la spunta apposta. L'indirizzo completo non
        viene conservato: resta l'impronta, che serve solo a riconoscerlo in fase di iscrizione.</p>
      <ul class="user-list">
        <% emailBloccate.forEach((b) => { %>
          <li class="user-row">
            <div class="user-head">
              <span class="user-name"><%= b.mascherata %></span>
              <% if (b.nickname) { %><span class="role-badge role-user">era <%= b.nickname %></span><% } %>
              <span class="user-pts"><%= oraItaliana(b.created_at) %><%= b.bloccata_da ? ' · ' + b.bloccata_da : '' %></span>
              <form action="/admin/email-bloccate/<%= b.id %>/sblocca" method="post"
                    data-confirm="Permettere di nuovo l'iscrizione a <%= b.mascherata %>?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn-mini" type="submit">Sblocca</button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <section class="card">
    <h2 class="staff-title"><%- icon('people') %> Utenti e ruoli (<%= users.length %>)</h2>
    <p class="muted small">Promuovi i tuoi collaboratori a <strong>moderatore</strong> (validano le prove)
      o <strong>admin</strong> (gestiscono tutto). Solo gli utenti normali compaiono in classifica.</p>

    <%# ── Ricerca e ordinamento ────────────────────────────────────────
        Tutto lato browser: le righe sono già tutte in pagina, quindi
        cercare e riordinare non ha motivo di passare dal server — e a
        ogni giro dal server si perderebbe la posizione nella lista. %>
    <div class="ul-barra" data-utenti-barra>
      <label class="ul-cerca">
        <%- icon('search') %>
        <input type="search" placeholder="Cerca per nickname o email…" data-utenti-cerca
               aria-label="Cerca un utente" autocomplete="off">
      </label>
      <div class="ul-ordini" role="group" aria-label="Ordina gli utenti">
        <button type="button" class="ul-ord is-attivo" data-utenti-ordina="iscrizione" aria-pressed="true">Iscrizione</button>
        <button type="button" class="ul-ord" data-utenti-ordina="alfabetico" aria-pressed="false">A–Z</button>
      </div>
    </div>
    <p class="muted small ul-esito" data-utenti-esito hidden></p>

    <ul class="user-list" data-utenti-lista>
      <% users.forEach((u, idx) => { %>
        <%# I dati per cercare e ordinare viaggiano sulla riga: il JS non deve
            rileggere il testo dentro i tag, che cambia appena si tocca la
            grafica. `data-i` tiene l'ordine di iscrizione, che e' quello con
            cui il server le manda: cosi' si torna indietro senza ricaricare. %>
        <li class="user-row" data-i="<%= idx %>"
            data-nome="<%= u.nickname.toLowerCase() %>"
            data-email="<%= (u.email || '').toLowerCase() %>">
          <div class="user-head">
            <span class="user-name"><%= u.nickname %></span>
            <span class="role-badge role-<%= u.role %>"><%= u.role %></span>
            <span class="user-pts"><%= u.points %> pt</span>
            <%# Da qui si vede da dove arrivano quei punti: serve quando un
                punteggio non torna e bisogna capire com'e' cresciuto. %>
            <a class="user-storico" href="/admin/punti/<%= u.id %>"><%- icon('list') %> Storico</a>
          </div>
          <p class="user-email">
            <% if (u.email) { %>
              <a href="mailto:<%= u.email %>"><%- icon('mail') %> <%= u.email %></a>
            <% } else { %>
              <span class="muted"><%- icon('mail') %> nessuna email registrata</span>
            <% } %>
            <%# La data d'iscrizione rende leggibile l'ordine della lista, e
                con l'ora si riconoscono gli arrivi in blocco. %>
            <span class="muted user-iscritto">iscritto il <%= oraItaliana(u.created_at, true) %></span>
          </p>
          <div class="user-actions">
            <form action="/admin/utenti/<%= u.id %>/ruolo" method="post" class="user-role-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="field-mini">Ruolo
                <select name="role">
                  <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>user</option>
                  <option value="moderator" <%= u.role === 'moderator' ? 'selected' : '' %>>moderator</option>
                  <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
                </select>
              </label>
              <button class="btn-mini" type="submit">Aggiorna</button>
            </form>
            <form action="/admin/utenti/<%= u.id %>/bonus" method="post" class="user-bonus"
                  data-confirm="Assegnare i punti bonus a questo utente?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="field-mini">Punti
                <input type="number" name="points" value="500" step="1" aria-label="Punti bonus" title="Punti bonus (negativi per correggere)">
              </label>
              <label class="field-mini field-grow">Motivo
                <input type="text" name="reason" placeholder="es. Contest Instagram" aria-label="Motivo" maxlength="120">
              </label>
              <button class="btn-mini" type="submit">+ Bonus</button>
            </form>
            <% if (u.role !== 'admin' && u.id !== currentUser.id) { %>
              <form action="/admin/utenti/<%= u.id %>/elimina" method="post" class="user-danger"
                    data-confirm="Eliminare DEFINITIVAMENTE l'account di <%= u.nickname %>? Spariscono anche le sue foto, storie e punti. Non si torna indietro.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="field-mini field-grow">La tua password admin
                  <input type="password" name="admin_password" placeholder="Password" autocomplete="current-password"
                         aria-label="La tua password admin, per confermare l'eliminazione">
                </label>
                <%# Non spuntata di default: bloccare e' una decisione, e la
                    cancellazione piu' comune (un utente che la chiede) non la
                    vuole. Sparisce se l'account non ha un'email da bloccare. %>
                <% if (u.email) { %>
                  <label class="check check-mini">
                    <input type="checkbox" name="blocca_email" value="1">
                    <span>Impedisci a questa email di iscriversi di nuovo</span>
                  </label>
                <% } %>
                <button class="btn-mini btn-danger" type="submit"><%- icon('trash') %> Elimina account</button>
              </form>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>
</div>

<%# ── STORIE SEGNALATE ─────────────────────────────────────────────── %>
<div class="adm-panel" id="p-segnalazioni" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card">
    <h2 class="staff-title"><%- icon('warning') %> Storie segnalate <span class="tag <%= reports.length ? 'tag-off' : 'tag-on' %>"><%= reports.length %></span></h2>
    <% if (reports.length) { %>
      <ul class="user-list">
        <% reports.forEach((r) => { %>
          <li class="user-row">
            <span class="user-name">Storia #<%= r.id %> di <%= r.author %>
              <span class="role-badge <%= r.hidden ? 'role-admin' : 'role-user' %>"><%= r.hidden ? 'nascosta' : 'visibile' %></span>
              <span class="user-pts"><%= r.reports %> segnalazion<%= r.reports === 1 ? 'e' : 'i' %></span>
            </span>
            <a class="btn-mini" href="/storie/media/<%= r.media_path.split('/').pop() %>" target="_blank" rel="noopener">Vedi foto</a>
            <form action="/admin/segnalazioni/<%= r.id %>/ignora" method="post" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn-mini" type="submit">Ignora</button>
            </form>
            <form action="/storie/<%= r.id %>/elimina" method="post" class="inline"
                  data-confirm="Eliminare questa storia segnalata?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn-mini" type="submit"><%- icon('trash') %> Elimina</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="muted small">Nessuna storia segnalata al momento.</p>
    <% } %>
  </section>
</div>

<div class="adm-panel" id="p-backup" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card">
    <h2 class="staff-title"><%- icon('save') %> Backup database</h2>
    <p class="muted small">Uno snapshot automatico ogni 6 ore (ultimi 30 conservati), più uno prima di ogni Reset Gioco. Copia locale sul server.</p>
    <form action="/admin/backup" method="post" style="margin-bottom:.8rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn-mini" type="submit"><%- icon('save') %> Backup ora</button>
    </form>
    <% if (backupList.length) { %>
      <ul class="user-list">
        <% backupList.slice(0, 15).forEach((b) => { %>
          <li class="user-row">
            <span class="user-name"><%= b.name %>
              <span class="user-pts"><%= (b.size / 1024 / 1024).toFixed(1) %> MB</span>
            </span>
            <a class="btn-mini" href="/admin/backup/<%= b.name %>"><%- icon('save') %> Scarica</a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="muted small">Nessun backup ancora creato.</p>
    <% } %>
  </section>
</div>

<%# ── REGISTRO AZIONI (AUDIT LOG) ──────────────────────────────────── %>
<div class="adm-panel" id="p-log" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card">
    <h2 class="staff-title"><%- icon('list') %> Registro azioni <span class="tag tag-on">ultime <%= logRows.length %></span></h2>
    <p class="muted small">Traccia di chi ha fatto cosa: ruoli, bonus punti, missioni, reset, notifiche, 2FA.</p>
    <% if (logRows.length) { %>
      <ul class="audit-list">
        <% logRows.forEach((l) => { %>
          <li class="audit-row">
            <span class="audit-time"><%= oraItaliana(l.created_at) %></span>
            <span class="audit-who"><%= l.nickname %></span>
            <span class="audit-action"><%= l.action %></span>
            <% if (l.details) { %><span class="audit-details"><%= l.details %></span><% } %>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="muted small">Nessuna azione registrata ancora.</p>
    <% } %>
  </section>
</div>

<%# ── RESET GIOCO ──────────────────────────────────────────────────── %>
<div class="adm-panel" id="p-reset" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card reset-card">
    <h2 class="staff-title"><%- icon('bolt') %> Reset Gioco <span class="tag tag-off">solo test</span></h2>
    <p class="muted small">
      Cancella <strong>tutti gli utenti non-admin</strong> (con email liberate: si potrà
      ri-registrare la stessa mail), le loro <strong>prove e foto</strong>, le <strong>storie</strong>
      e azzera la <strong>classifica</strong>. Restano <strong>missioni</strong> e <strong>codici premio</strong>
      (i link/QR tornano riscattabili). Gli account admin restano, ma con statistiche di gioco azzerate.
      <strong>Azione irreversibile.</strong>
    </p>
    <form action="/admin/reset-gioco" method="post"
          data-confirm="⚠️ RESET DEFINITIVO: vuoi davvero cancellare tutti i dati di gioco? Gli admin rimarranno.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label style="margin-bottom:.5rem">
        Scrivi <strong>RESET</strong> per confermare
        <input type="text" name="conferma" placeholder="RESET" autocomplete="off"
               style="max-width:160px; margin-top:.3rem">
      </label>
      <label style="margin-bottom:.5rem; margin-top:.5rem">
        Inserisci la tua <strong>password admin</strong>
        <input type="password" name="admin_password" placeholder="Password" autocomplete="current-password"
               style="max-width:220px; margin-top:.3rem">
      </label>
      <div>
        <button class="btn btn-no" type="submit"><%- icon('bolt') %> Reset Gioco</button>
      </div>
    </form>
  </section>
</div>

<%# ── SETTIMANA DI SOLE ISCRIZIONI ──────────────────────────────────── %>
<div class="adm-panel" id="p-iscrizioni" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card">
    <h2 class="staff-title"><%- icon('lock') %> Settimana di sole iscrizioni</h2>

    <% if (soloIscrizioni) { %>
      <div class="iscr-stato iscr-stato-on">
        <%- icon('lock') %> <span><strong>ATTIVA</strong> — i giocatori vedono solo le pagine aperte.</span>
      </div>
    <% } else { %>
      <div class="iscr-stato iscr-stato-off">
        <%- icon('check') %> <span><strong>SPENTA</strong> — l'app è aperta tutta.</span>
      </div>
    <% } %>
    <% if (iscrizioniQuando) { %>
      <p class="iscr-quando">Ultimo cambio: <%= iscrizioniQuando %> (UTC)</p>
    <% } %>

    <p class="muted small">
      Con l'interruttore acceso restano aperte <strong>solo</strong> queste pagine:
    </p>
    <ul class="iscr-elenco">
      <li>Home, Classifica, Programmazione, Palio dei Fuochi, Galleria, Storia, Profilo</li>
      <li>Ruota della Fortuna e bonus giornaliero — <strong>i due soli modi di fare punti</strong></li>
      <li>Iscrizione, accesso, recupero password, privacy e termini</li>
    </ul>
    <p class="muted small">
      Restano chiusi missioni, mini-giochi, slot, sfide fra amici, codici premio e la pagina
      dei premi. Chi ci prova vede una pagina che dice quando si apre, non un errore.
      <strong>Lo staff non è mai bloccato</strong>: tu continui a vedere e preparare tutto.
    </p>

    <p class="muted small">
      Accendere e spegnere <strong>non tocca niente</strong>: né punti, né iscritti, né
      classifica. È solo un cancello. Chi si iscrive stanotte e gira la Ruota per una
      settimana, quando riapri si ritrova esattamente i punti che aveva.
    </p>

    <% if (soloIscrizioni) { %>
      <form action="/admin/iscrizioni" method="post"
            data-confirm="Aprire TUTTA l'app? Missioni, giochi e slot diventano visibili a tutti. I punti già fatti restano.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="accendi" value="0">
        <button class="btn" type="submit"><%- icon('check') %> Apri tutta l'app</button>
      </form>
    <% } else { %>
      <form action="/admin/iscrizioni" method="post"
            data-confirm="Chiudere l'app a tutti tranne le iscrizioni? Missioni, giochi e slot spariscono per i giocatori. Nessun dato viene perso.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="accendi" value="1">
        <button class="btn btn-no" type="submit"><%- icon('lock') %> Attiva sole iscrizioni</button>
      </form>
    <% } %>
  </section>
</div>

<%# ── SAN ROCCO JETPACK (mini-gioco pixel, anteprima) ───────────────── %>
<link rel="stylesheet" href="/jetpack.css?v=10">
<div class="adm-panel" id="p-jetpack" hidden>
  <button type="button" class="adm-back" data-back><%- icon('arrow-left') %> Torna al pannello</button>

  <section class="card">
    <h2 class="staff-title"><%- icon('fireworks') %> San Rocco Jetpack <span class="tag tag-off">beta</span></h2>
    <p class="muted small" style="margin-bottom:1rem">
      Anteprima del nuovo mini-gioco in stile <em>Jetpack Joyride</em>, pixelato e a tema San Rocco.
      Tieni premuto per volare con la fiammata dorata, schiva i raggi di fuoco e raccogli le monete.
      Per ora è qui solo per test: dopo decidiamo dove posizionarlo.
    </p>

    <div class="jp-wrap" id="jpRoot">
      <div class="jp-stage">
        <div class="jp-hud">
          <span id="jpScore">0 m</span>
          <span class="jp-best" id="jpBest">record 0</span>
        </div>
<% } %>
        <canvas class="jp-canvas" id="jpCanvas" aria-label="San Rocco Jetpack"></canvas>

        <%# Muta la canzone %>
        <button class="jp-mute-toggle" id="jpMuteBtn" type="button" aria-label="Muta la canzone" aria-pressed="false" title="Muta la canzone">
          <svg class="jp-ic-on" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M18.5 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="jp-ic-off" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 9l6 6M22 9l-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>

        <%# Pausa (visibile solo in gioco) %>
        <button class="jp-pause-toggle" id="jpPauseBtn" type="button" aria-label="Pausa" title="Pausa">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="0.5"/><rect x="14" y="5" width="4" height="14" rx="0.5"/></svg>
        </button>

        <div class="jp-toast" id="jpToast"></div>

        <div class="jp-overlay" id="jpOverlay">
          <p class="jp-kicker" id="jpKicker">Insert coin</p>
          <h3 class="jp-over-title" id="jpOverTitle">San Rocco Jetpack</h3>
          <p class="jp-over-desc" id="jpOverDesc">Vola con la fiammata, schiva i raggi di fuoco, raccogli le monete</p>
          <p class="jp-hint" id="jpHint">Tieni premuto <kbd>SPAZIO</kbd>, tocca lo schermo o il tasto <kbd>SALI</kbd> per volare</p>
          <button type="button" class="jp-play" id="jpPlay">Gioca</button>
        </div>

        <%# Overlay di pausa %>
        <div class="jp-overlay jp-hidden" id="jpPause" aria-hidden="true">
          <p class="jp-kicker">II</p>
          <h3 class="jp-over-title">Pausa</h3>
          <p class="jp-hint">Premi <kbd>P</kbd> o <kbd>Esc</kbd> per riprendere</p>
          <div class="jp-pause-btns">
            <button type="button" class="jp-play" id="jpResume">Riprendi</button>
            <button type="button" class="jp-btn2" id="jpRestart">Ricomincia</button>
            <button type="button" class="jp-btn2" id="jpQuit">Esci</button>
          </div>
        </div>
      </div>

      <%# Controller: pulsante di spinta (oltre al tocco sullo schermo) %>
      <div class="jp-pad" id="jpPad">
        <button class="jp-thrust" id="jpThrust" type="button" aria-label="Sali / spinta">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20V6"/><path d="M6 12l6-6 6 6"/></svg>
          <span class="jp-thrust-label">SALI</span>
        </button>
      </div>

      <p class="jp-note">Prototipo · i punteggi non incidono sulla classifica</p>
    </div>
  </section>
</div>

<script src="/admin.js?v=8" defer></script>
<script src="/jetpack.js?v=11" defer></script>
