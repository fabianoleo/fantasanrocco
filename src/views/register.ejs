<section class="card form-card">
  <h1>Registrati</h1>
  <p class="muted">Si partecipa da singoli giocatori: niente squadre, ognuno gioca per sé. Scegli il tuo nickname e una password. L'email serve solo per recuperare la password se la dimentichi.</p>
  <form action="/registrati" method="post" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Nickname
      <input type="text" name="nickname" required minlength="2" maxlength="24" placeholder="es. Peppe93">
      <span class="muted small">Il nickname è personale: si gioca da soli, non in squadra.</span>
    </label>
    <label>Email <span style="color:var(--red)">*</span>
      <input type="email" name="email" required placeholder="la tua email">
    </label>
    <label>Password
      <input type="password" name="password" required minlength="8" autocomplete="new-password"
             placeholder="almeno 8 caratteri" data-forza>
    </label>
    <%# Arrivando dal link di un amico il campo e' gia' pieno: chi ha il
        codice nell'indirizzo non deve ricopiarlo a mano. %>
    <label>Codice invito <span class="muted small">(facoltativo)</span>
      <input type="text" name="invito" maxlength="16" value="<%= invito %>"
             placeholder="es. K7M2QP" style="text-transform:uppercase" autocomplete="off">
      <span class="muted small">Se un amico ti ha invitato, scrivi qui il suo codice: gli regali <%= puntiInvito %> punti.</span>
    </label>
    <label class="check">
      <input type="checkbox" name="privacy_ok" required>
      <span>Ho letto e accetto la <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a> e i <a href="/termini" target="_blank" rel="noopener">Termini di servizio</a>.</span>
    </label>
    <label class="check">
      <input type="checkbox" name="age_ok" required>
      <span>Dichiaro di avere almeno 14 anni, oppure di avere l'autorizzazione di un genitore/tutore.</span>
    </label>
    <button class="btn" type="submit">Crea account</button>
  </form>
  <p class="muted small" style="margin-top:1rem">Hai già un account? <a href="/login">Accedi</a></p>
</section>
