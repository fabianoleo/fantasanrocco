# Copia questo file in ".env" e personalizzalo.
# (cp .env.example .env)

# Porta su cui gira l'app dentro il container / in locale
PORT=3000

# Cartella dove vengono salvati database e foto caricate.
# In Docker è montata come volume, NON cambiarla se usi docker compose.
DATA_DIR=./data

# Segreto per firmare i cookie di sessione.
# IMPORTANTISSIMO: mettine uno lungo e casuale e NON condividerlo.
# Generane uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambiami-con-una-stringa-lunga-e-casuale

# Metti "true" SOLO quando l'app è esposta in HTTPS (es. tramite Cloudflare Tunnel).
# In locale (http://localhost) lascialo "false", altrimenti il login non funziona.
SECURE_COOKIES=false

# Dimensione massima foto in MB
MAX_UPLOAD_MB=8

# URL pubblico dell'app (con https://). OBBLIGATORIO in produzione.
# I link di reset password si costruiscono SOLO da qui, MAI dall'header Host
# della richiesta (altrimenti un attaccante potrebbe falsificarlo e rubare il
# token di reset). In locale puoi lasciare il default localhost.
APP_URL=http://localhost:3000

# --- POSTA IN USCITA (reset password e inviti alle sfide) ---
# Servono due cose perché le mail NON finiscano in spam:
#  1. un mittente sul DOMINIO nostro, non un @gmail.com. Una casella Gmail
#     normale non è un mittente transazionale: i filtri la trattano come
#     sospetta a prescindere, e la reputazione è legata a quel solo indirizzo.
#  2. i record DNS (SPF, DKIM, DMARC) che dicono ai filtri che quel servizio
#     ha il permesso di scrivere a nome nostro. Senza, il dominio è scoperto.
#
# Con Resend: verifica il dominio nel pannello, incolla i record che ti dà
# nel DNS, poi qui sotto. La chiave è una password: non finisce mai nel
# repository (.env è in .gitignore) e si rigenera se viene vista da qualcuno.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_la_tua_chiave_resend
SMTP_FROM=noreply@fantasanrocco.com
# Dove arrivano le risposte. Deve essere una casella che qualcuno legge
# davvero: una mail a cui non si può rispondere è un altro segnale negativo.
EMAIL_REPLY_TO=fantasanrocco@gmail.com

# ATTENZIONE: EMAIL_USER ha la PRECEDENZA su SMTP_HOST (vedi lib/email.js).
# Se resta impostato, l'app continua a mandare da Gmail e tutto quanto sopra
# non serve a niente. Passando a Resend va tolto o lasciato vuoto.
# EMAIL_USER=
# EMAIL_PASS=
